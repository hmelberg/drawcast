{
  "name": "drawcast",
  "description": "drawcast — animated, narrated, hand-drawn explainer figures from a structured drawing spec, with an AI editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:engine": "tsc && vite build --config vite.engine.config.ts && node scripts/check-engine-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@netlify/blobs": "^11.0.1",
    "3dmol": "^2.5.5",
    "ajv": "^8.17.1",
    "chess.js": "^1.4.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "js-yaml": "^4.1.0",
    "mathjax-full": "^3.2.2",
    "roughjs": "^4.6.6",
    "smiles-drawer": "^2.4.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
