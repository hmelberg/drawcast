  {
    "request": "Why does a dropped ball speed up? Show the equations with the curve.",
    "spec": {
      "title": "How far a dropped ball has fallen",
      "domain": {
        "x": [
          0,
          3
        ],
        "y": [
          0,
          50
        ]
      },
      "elements": [
        {
          "id": "ax",
          "type": "axes",
          "x_label": "Time (s)",
          "y_label": "Distance fallen (m)"
        },
        {
          "id": "steady",
          "type": "curve",
          "expr": "14.7*x",
          "style": {
            "color": "#8f887c",
            "dash": true
          }
        },
        {
          "id": "fall",
          "type": "curve",
          "expr": "4.9*x*x",
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "p2",
          "type": "point",
          "at": {
            "x": 2,
            "y": 19.6
          },
          "style": {
            "color": "#2f6b8f"
          }
        },
        {
          "id": "tang",
          "type": "line",
          "through": [
            {
              "ref": "p2"
            }
          ],
          "slope": 19.6,
          "style": {
            "color": "#2f6b8f",
            "dash": true
          }
        },
        {
          "id": "lab_v",
          "type": "label",
          "tex": "v = gt",
          "attach_to": "p2",
          "side": "below-right"
        },
        {
          "id": "eq_s",
          "type": "math",
          "tex": "s = \\tfrac{1}{2} g t^2",
          "size": 34,
          "at": {
            "ref": "p2",
            "side": "above-left",
            "gap": 30
          }
        }
      ],
      "commands": [
        {
          "draw": [
            "ax"
          ],
          "speak": "A dropped ball covers far more ground in its second second than in its first. Here is why."
        },
        {
          "draw": [
            "steady"
          ],
          "speak": "At a steady speed, the distance would grow along this straight line."
        },
        {
          "draw": [
            "fall"
          ],
          "speak": "It does not. The real fall bends upward: every second adds more than the one before."
        },
        {
          "erase": [
            "steady"
          ],
          "speak": "Gravity does not hand out distance at a fixed rate — it hands out speed."
        },
        {
          "draw": [
            "p2",
            "tang",
            "lab_v"
          ],
          "speak": "The steepness at any instant is the speed, and it grows ten metres per second every second."
        },
        {
          "draw": [
            "eq_s"
          ],
          "speak": "Add that growing speed up and the distance goes as the square of the time."
        },
        {
          "highlight": {
            "target": [
              "fall"
            ],
            "effect": "glow"
          },
          "speak": "So it falls five metres in the first second and fifteen in the next — three times as far, from a standing start."
        }
      ]
    }
  },
