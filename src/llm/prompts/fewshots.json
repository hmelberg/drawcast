        {
          "id": "req",
          "type": "arrow",
          "from": {
            "ref": "client"
          },
          "to": {
            "ref": "server"
          },
          "curved": true
        },
        {
          "id": "resp",
          "type": "arrow",
          "from": {
            "ref": "server"
          },
          "to": {
            "ref": "client"
          },
          "curved": true
        },
        {
          "id": "query",
          "type": "arrow",
          "from": {
            "ref": "server"
          },
          "to": {
            "ref": "db"
          },
          "curved": true
        },
        {
          "id": "rows",
          "type": "arrow",
          "from": {
            "ref": "db"
          },
          "to": {
            "ref": "server"
          },
          "curved": true
        },
        {
          "id": "label_req",
          "type": "label",
          "text": "GET /profile",
          "attach_to": "req",
          "side": "above"
        },
        {
          "id": "label_query",
          "type": "label",
          "text": "SELECT * FROM users",
          "attach_to": "query",
          "side": "above"
        }
      ],
      "commands": [
        {
          "draw": [
            "client",
            "server",
            "db"
          ],
          "parallel": true,
          "speak": "A web request passes through three parts before an answer comes back: the client, the server, and its database."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "req",
            "label_req"
          ],
          "speak": "The client asks the server for a page."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "query",
            "label_query"
          ],
          "speak": "The server, in turn, queries the database for the data it needs."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "rows",
            "resp"
          ],
          "speak": "The database returns rows, and the server sends its response back to the client."
        },
        {
          "point": {
            "at": {
              "ref": "server"
            },
            "gesture": "circle"
          },
          "speak": "The server sits in the middle, coordinating both sides."
        }
      ]
    }
  },
