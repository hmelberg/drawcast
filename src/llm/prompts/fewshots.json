[
  {
    "request": "Draw a demand and supply diagram, then show demand increasing.",
    "spec": {
      "title": "Demand increase",
      "template": "supply_demand",
      "params": {
        "demand": { "curvature": "linear", "label": "D" },
        "supply": { "label": "S" },
        "equilibrium": { "show": true, "guides": true },
        "demand_shift": { "direction": "right", "label": "D′" }
      },
      "commands": [
        { "speak": "Let's build a market diagram and find where the price settles." },
        { "draw": ["axes"] },
        { "speak": "Price on the vertical axis, quantity on the horizontal." },
        { "draw": ["demand_curve", "label_D"] },
        { "speak": "This falling line is demand: as price falls, quantity demanded rises.", "blocking": false },
        { "point": { "at": { "ref": "demand_curve" }, "gesture": "underline" } },
        { "draw": ["supply_curve", "label_S"] },
        { "speak": "And this rising line is supply: higher prices call forth more production." },
        { "draw": ["equilibrium_point", "guide_lines", "label_E", "label_Pstar", "label_Qstar"] },
        { "speak": "Where the two lines cross, the market clears — this is the equilibrium.", "blocking": false },
        { "point": { "at": { "ref": "equilibrium_point" }, "gesture": "circle" } },
        { "pause": 0.5 },
        { "draw": ["demand_shift_curve", "demand_shift_arrow", "label_D_shift"] },
        { "speak": "Now demand has increased: the whole curve has shifted to the right.", "blocking": false },
        { "highlight": { "target": ["demand_shift_curve"], "effect": "pulse" } }
      ]
    }
  },
  {
    "request": "Draw a decision tree for choosing between surgery and watchful waiting, with QALY payoffs.",
    "spec": {
      "title": "Surgery vs watchful waiting",
      "template": "decision_tree",
      "params": {
        "root": {
          "id": "choice",
          "type": "decision",
          "label": "Choose strategy",
          "children": [
            {
              "label": "Surgery",
              "node": {
                "id": "surgery",
                "type": "chance",
                "label": "Operate",
                "children": [
                  { "label": "Success", "probability": 0.85, "node": { "id": "ok", "type": "terminal", "label": "Recovered", "payoff": 9.2 } },
                  { "label": "Complication", "probability": 0.15, "node": { "id": "comp", "type": "terminal", "label": "Complication", "payoff": 5.1 } }
                ]
              }
            },
            { "label": "Watchful waiting", "node": { "id": "wait", "type": "terminal", "label": "No operation", "payoff": 7.4 } }
          ]
        }
      },
      "commands": [
        { "speak": "The choice: operate, or wait. Let's map the decision." },
        { "draw": ["node_choice", "label_choice"] },
        { "speak": "This square is the decision we control: operate, or wait.", "blocking": false },
        { "point": { "at": { "ref": "node_choice" }, "gesture": "tap" } },
        { "draw": ["edge_choice_surgery", "branchlabel_choice_surgery", "node_surgery", "label_surgery"] },
        { "speak": "Surgery leads to this circle — a chance node — because the outcome is uncertain." },
        { "draw": ["edge_surgery_ok", "branchlabel_surgery_ok", "node_ok", "label_ok", "payoff_ok", "edge_surgery_comp", "branchlabel_surgery_comp", "node_comp", "label_comp", "payoff_comp"] },
        { "speak": "With probability 0.85 the operation succeeds; with 0.15 there is a complication.", "blocking": false },
        { "highlight": { "target": ["payoff_ok", "payoff_comp"], "effect": "circle" } },
        { "draw": ["edge_choice_wait", "branchlabel_choice_wait", "node_wait", "label_wait", "payoff_wait"] },
        { "speak": "Watchful waiting avoids the risk, at a lower expected payoff." }
      ]
    }
  },
  {
    "request": "Illustrate diminishing marginal utility.",
    "spec": {
      "title": "Diminishing marginal utility",
      "domain": { "x": [0, 10], "y": [0, 100] },
      "elements": [
        { "id": "ax", "type": "axes", "x_label": "Quantity consumed", "y_label": "Total utility" },
        { "id": "utility", "type": "curve", "expr": "100*(1 - exp(-0.4*x))", "style": { "color": "#2f6b8f" } },
        { "id": "u_label", "type": "label", "text": "U(x)", "attach_to": "utility", "side": "above" },
        { "id": "p1", "type": "point", "at": { "x": 2, "y": 55.1 }, "guides": true },
        { "id": "p2", "type": "point", "at": { "x": 6, "y": 90.9 }, "guides": true },
        { "id": "note", "type": "label", "text": "Each extra unit adds less", "attach_to": "p2", "side": "below-right" }
      ],
      "commands": [
        { "speak": "Let's see why the first unit we consume matters more than the sixth." },
        { "draw": ["ax", "utility", "u_label"] },
        { "speak": "Total utility rises as we consume more — but the curve keeps flattening.", "blocking": false },
        { "point": { "at": { "ref": "utility" }, "gesture": "underline" } },
        { "draw": ["p1", "p2"], "parallel": true },
        { "speak": "Compare these two points: the first two units bring utility to 55, while the next four only lift it to 91.", "blocking": false },
        { "highlight": { "target": ["p1", "p2"], "effect": "circle" } },
        { "draw": ["note"] },
        { "speak": "That flattening is diminishing marginal utility." }
      ]
    }
  },
  {
    "request": "Draw a Markov model with Healthy, Sick and Dead states.",
    "spec": {
      "title": "Three-state Markov model",
      "elements": [
        { "id": "healthy", "type": "node", "shape": "circle", "text": "Healthy" },
        { "id": "sick", "type": "node", "shape": "circle", "text": "Sick" },
        { "id": "dead", "type": "node", "shape": "circle", "text": "Dead" },
        { "id": "h_s", "type": "arrow", "from": { "ref": "healthy" }, "to": { "ref": "sick" }, "curved": true },
        { "id": "s_h", "type": "arrow", "from": { "ref": "sick" }, "to": { "ref": "healthy" }, "curved": true },
        { "id": "s_d", "type": "arrow", "from": { "ref": "sick" }, "to": { "ref": "dead" }, "curved": true },
        { "id": "h_d", "type": "arrow", "from": { "ref": "healthy" }, "to": { "ref": "dead" }, "curved": true },
        { "id": "p_hs", "type": "label", "text": "0.10", "attach_to": "h_s", "side": "above" },
        { "id": "p_sd", "type": "label", "text": "0.05", "attach_to": "s_d", "side": "right" }
      ],
      "commands": [
        { "speak": "A Markov model follows people between health states over time." },
        { "draw": ["healthy", "sick", "dead"], "parallel": true },
        { "speak": "Three states: healthy, sick — and dead.", "blocking": false },
        { "highlight": { "target": ["healthy", "sick", "dead"], "effect": "pulse" } },
        { "draw": ["h_s", "p_hs", "s_h"] },
        { "speak": "Each cycle, ten percent of the healthy fall ill — and the sick can recover." },
        { "draw": ["s_d", "p_sd", "h_d"] },
        { "speak": "They can also die, and death is absorbing: no arrows lead back out.", "blocking": false },
        { "point": { "at": { "ref": "dead" }, "gesture": "circle" } }
      ]
    }
  }
]
