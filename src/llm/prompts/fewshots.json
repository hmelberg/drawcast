[
  {
    "request": "Draw a demand and supply diagram, then show demand increasing.",
    "spec": {
      "title": "When demand rises",
      "template": "supply_demand",
      "params": {
        "numbering": "index",
        "demand": {
          "curvature": "linear"
        },
        "supply": {},
        "equilibrium": {
          "show": true,
          "guides": true
        },
        "demand_shift": {
          "direction": "right",
          "arrow": "horizontal"
        }
      },
      "commands": [
        {
          "card": {
            "title": "When demand rises"
          }
        },
        {
          "draw": [
            "axes"
          ],
          "speak": "What happens to price and quantity when more people want something — ice cream on the first hot day, say?"
        },
        {
          "draw": [
            "demand_curve",
            "label_D"
          ],
          "speak": "Demand: the lower the price, the more ice cream people want."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "supply_curve",
            "label_S"
          ],
          "speak": "Supply: the higher the price, the more sellers are willing to make and sell."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "equilibrium_point",
            "guide_lines",
            "label_E",
            "label_Pstar",
            "label_Qstar"
          ],
          "speak": "On an ordinary day they meet here: the one price at which buyers want exactly what sellers offer."
        },
        {
          "pause": 0.5
        },
        {
          "draw": [
            "demand_shift_curve",
            "demand_shift_arrow",
            "label_D_shift"
          ],
          "speak": "Then the heat arrives. At every price, people now want more: the whole demand curve moves right."
        },
        {
          "point": {
            "at": {
              "ref": "equilibrium_point"
            },
            "gesture": "circle"
          },
          "speak": "At the old price, the queue is longer than what sellers have."
        },
        {
          "draw": [
            "shift_equilibrium_point",
            "shift_guide_lines",
            "label_E_shift",
            "label_P_shift",
            "label_Q_shift"
          ],
          "speak": "So the price climbs — some buyers give up, sellers make more — until the two meet again: higher price, more ice cream."
        },
        {
          "highlight": {
            "target": [
              "supply_curve"
            ]
          },
          "speak": "And supply never moved. Sellers slid along their own curve: a change in the quantity supplied, not in supply."
        },
        {
          "quiz": {
            "question": "If supply had shifted right instead, what would the price do?",
            "choices": [
              "Rise",
              "Fall"
            ],
            "correct": 2,
            "right": "It falls: more is offered at every price, so sellers must cut the price to find buyers."
          }
        }
      ]
    }
  },
  {
    "request": "Draw a decision tree for choosing between surgery and watchful waiting, with QALY payoffs.",
    "spec": {
      "title": "Surgery vs watchful waiting",
      "template": "decision_tree",
      "params": {
        "root": {
          "id": "choice",
          "type": "decision",
          "label": "Choose strategy",
          "children": [
            {
              "label": "Surgery",
              "node": {
                "id": "surgery",
                "type": "chance",
                "label": "Operate",
                "children": [
                  {
                    "label": "Success",
                    "probability": 0.85,
                    "node": {
                      "id": "ok",
                      "type": "terminal",
                      "label": "Recovered",
                      "payoff": 9.2
                    }
                  },
                  {
                    "label": "Complication",
                    "probability": 0.15,
                    "node": {
                      "id": "comp",
                      "type": "terminal",
                      "label": "Complication",
                      "payoff": 5.1
                    }
                  }
                ]
              }
            },
            {
              "label": "Watchful waiting",
              "node": {
                "id": "wait",
                "type": "terminal",
                "label": "No operation",
                "payoff": 7.4
              }
            }
          ]
        }
      },
      "elements": [
        {
          "id": "rule_out",
          "type": "annotation",
          "target": "label_wait",
          "kind": "strike"
        }
      ],
      "commands": [
        {
          "card": {
            "title": "Operate, or wait?"
          }
        },
        {
          "draw": [
            "node_choice",
            "label_choice"
          ],
          "speak": "Should she have surgery now, or wait and watch? This square is the decision we control."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "edge_choice_surgery",
            "branchlabel_choice_surgery",
            "node_surgery",
            "label_surgery"
          ],
          "speak": "Surgery leads to a circle — a chance node — because the outcome is uncertain."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "edge_surgery_ok",
            "branchlabel_surgery_ok",
            "node_ok",
            "label_ok",
            "payoff_ok",
            "edge_surgery_comp",
            "branchlabel_surgery_comp",
            "node_comp",
            "label_comp",
            "payoff_comp"
          ],
          "speak": "With probability 0.85 the operation succeeds; with 0.15 there is a complication."
        },
        {
          "highlight": {
            "target": [
              "payoff_ok",
              "payoff_comp"
            ],
            "effect": "circle"
          },
          "speak": "The payoffs: 9.2 QALYs after recovery, 5.1 after a complication."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "edge_choice_wait",
            "branchlabel_choice_wait",
            "node_wait",
            "label_wait",
            "payoff_wait"
          ],
          "speak": "Watchful waiting avoids the risk, at a lower expected payoff."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "rule_out"
          ],
          "speak": "Expected value favours surgery — about 8.6 against 7.4 QALYs — so we rule out waiting."
        }
      ]
    }
  },
  {
    "request": "Illustrate diminishing marginal utility.",
    "spec": {
      "title": "Diminishing marginal utility",
      "domain": {
        "x": [
          0,
          6
        ],
        "y": [
          0,
          100
        ]
      },
      "elements": [
        {
          "id": "ax",
          "type": "axes",
          "x_label": "Units, one after another",
          "y_label": "Total enjoyment"
        },
        {
          "id": "choc",
          "type": "curve",
          "expr": "100*(1 - exp(-0.45*x))",
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "choc_label",
          "type": "label",
          "text": "Chocolate",
          "attach_to": "choc",
          "side": "above"
        },
        {
          "id": "p1",
          "type": "point",
          "at": {
            "x": 1,
            "y": 36.2
          },
          "guides": true,
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "p2",
          "type": "point",
          "at": {
            "x": 2,
            "y": 59.3
          },
          "guides": true,
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "p3",
          "type": "point",
          "at": {
            "x": 3,
            "y": 74.1
          },
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "p4",
          "type": "point",
          "at": {
            "x": 4,
            "y": 83.5
          },
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "g1",
          "type": "label",
          "text": "+36",
          "attach_to": "p1",
          "side": "left"
        },
        {
          "id": "g2",
          "type": "label",
          "text": "+23",
          "attach_to": "p2",
          "side": "above-left"
        },
        {
          "id": "g3",
          "type": "label",
          "text": "+15",
          "attach_to": "p3",
          "side": "above-left"
        },
        {
          "id": "g4",
          "type": "label",
          "text": "+9",
          "attach_to": "p4",
          "side": "above-left"
        },
        {
          "id": "song",
          "type": "curve",
          "expr": "100/(1 + exp(-1.4*(x - 3)))",
          "style": {
            "color": "#8a5fa8",
            "dash": true
          }
        },
        {
          "id": "song_label",
          "type": "label",
          "text": "A new song",
          "attach_to": "song",
          "side": "right"
        }
      ],
      "commands": [
        {
          "card": {
            "title": "Diminishing marginal utility"
          }
        },
        {
          "draw": [
            "ax"
          ],
          "speak": "Why is the first square of chocolate so much better than the fourth? Economists call it diminishing marginal utility."
        },
        {
          "draw": [
            "choc",
            "choc_label"
          ],
          "speak": "Here is how much you enjoy eating squares one after another, added up."
        },
        {
          "draw": [
            "p1",
            "g1"
          ],
          "speak": "The first square takes you from nothing to thirty-six."
        },
        {
          "draw": [
            "p2",
            "g2"
          ],
          "speak": "The second adds twenty-three: still good, but two squares do not make you twice as happy."
        },
        {
          "draw": [
            "p3",
            "g3",
            "p4",
            "g4"
          ],
          "speak": "The third adds fifteen, the fourth only nine: each extra square — the marginal one — adds less."
        },
        {
          "highlight": {
            "target": [
              "choc"
            ]
          },
          "speak": "Why? The craving gets used up. The first square meets a real hunger for sweetness; by the fourth you are close to full."
        },
        {
          "pause": 0.4
        },
        {
          "draw": [
            "song",
            "song_label"
          ],
          "speak": "It is not a law of nature, though. A new song can be better the fourth time than the first, because you hear more in it each time."
        },
        {
          "highlight": {
            "target": [
              "song"
            ]
          },
          "speak": "Its curve bends UP before it flattens: rising marginal utility, for a while, and then even the best song wears out."
        },
        {
          "point": {
            "at": {
              "ref": "p4"
            },
            "gesture": "circle"
          },
          "speak": "And timing matters: the rule is about units in a row. Next week, a square is as good as the first one was today."
        },
        {
          "highlight": {
            "target": [
              "g1",
              "g2",
              "g3",
              "g4"
            ]
          },
          "speak": "That is why one more of something you already have plenty of is worth so little to you — and why you would pay less for it."
        }
      ]
    }
  },
  {
    "request": "Show a client sending a request to a server that queries a database.",
    "spec": {
      "title": "A web request, round trip",
      "elements": [
        {
          "id": "client",
          "type": "node",
          "shape": "rect",
          "text": "Browser"
        },
        {
          "id": "server",
          "type": "node",
          "shape": "rect",
          "text": "Server"
        },
        {
          "id": "db",
          "type": "node",
          "shape": "rect",
          "text": "Database"
        },
        {
          "id": "chain",
          "type": "group",
          "members": [
            "client",
            "server",
            "db"
          ],
          "layout": "row",
          "gap": 260,
          "fit": "full"
        },
        {
          "id": "req",
          "type": "arrow",
          "from": {
            "ref": "client"
          },
          "to": {
            "ref": "server"
          }
        },
        {
          "id": "query",
          "type": "arrow",
          "from": {
            "ref": "server"
          },
          "to": {
            "ref": "db"
          }
        },
        {
          "id": "rows",
          "type": "arrow",
          "from": {
            "ref": "db"
          },
          "to": {
            "ref": "server"
          }
        },
        {
          "id": "resp",
          "type": "arrow",
          "from": {
            "ref": "server"
          },
          "to": {
            "ref": "client"
          }
        },
        {
          "id": "label_req",
          "type": "label",
          "text": "GET /profile",
          "attach_to": "req",
          "side": "above"
        },
        {
          "id": "label_query",
          "type": "label",
          "text": "SELECT … id = 42",
          "attach_to": "query",
          "side": "above"
        },
        {
          "id": "label_rows",
          "type": "label",
          "text": "one row",
          "attach_to": "rows",
          "side": "below"
        },
        {
          "id": "label_resp",
          "type": "label",
          "text": "a page",
          "attach_to": "resp",
          "side": "below"
        }
      ],
      "commands": [
        {
          "card": {
            "title": "A web request, round trip"
          }
        },
        {
          "draw": [
            "client",
            "server",
            "db"
          ],
          "speak": "What happens between clicking “my profile” and seeing it? Three parts take turns: your browser, a server, and its database."
        },
        {
          "draw": [
            "req",
            "label_req"
          ],
          "speak": "The browser asks the server for the profile page."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "query",
            "label_query"
          ],
          "speak": "The server does not have your profile to hand. It asks the database for exactly one row: yours."
        },
        {
          "draw": [
            "rows",
            "label_rows"
          ],
          "speak": "The database sends that row back."
        },
        {
          "draw": [
            "resp",
            "label_resp"
          ],
          "speak": "And the server fills it into a page and returns it to the browser."
        },
        {
          "flow": {
            "along": [
              "req",
              "query",
              "rows",
              "resp"
            ]
          },
          "speak": "Round trip: out and back, twice, usually in a fraction of a second."
        },
        {
          "point": {
            "at": {
              "ref": "server"
            },
            "gesture": "circle"
          },
          "speak": "Why not let the browser ask the database itself? Because the server is where the rules live: it checks who you are and asks only for what you may see."
        }
      ]
    }
  },
  {
    "request": "How does a bicycle pump push air into a tyre?",
    "spec": {
      "title": "Inside a bicycle pump",
      "elements": [
        {
          "id": "body",
          "type": "shape",
          "shape": "rect",
          "x": 45,
          "y": 160,
          "width": 90,
          "height": 320
        },
        {
          "id": "piston",
          "type": "shape",
          "shape": "rect",
          "width": 74,
          "height": 26,
          "at": {
            "ref": "body",
            "anchor": "top"
          },
          "anchor": "top",
          "style": {
            "fill": "#2f6b8f",
            "color": "#2f6b8f"
          }
        },
        {
          "id": "rod",
          "type": "shape",
          "shape": "rect",
          "width": 10,
          "height": 110,
          "at": {
            "ref": "piston",
            "anchor": "top"
          },
          "anchor": "bottom"
        },
        {
          "id": "handle",
          "type": "shape",
          "shape": "rect",
          "width": 150,
          "height": 26,
          "at": {
            "ref": "rod",
            "anchor": "top"
          },
          "anchor": "bottom"
        },
        {
          "id": "plunger",
          "type": "group",
          "members": [
            "piston",
            "rod",
            "handle"
          ]
        },
        {
          "id": "hose",
          "type": "path",
          "points": [
            [
              0,
              0
            ],
            [
              90,
              -40
            ],
            [
              210,
              -70
            ]
          ],
          "smooth": true,
          "at": {
            "ref": "body",
            "anchor": "bottom_right"
          },
          "anchor": "top_left"
        },
        {
          "id": "valve",
          "type": "shape",
          "shape": "circle",
          "radius": 16,
          "at": {
            "ref": "hose",
            "anchor": "end"
          },
          "style": {
            "fill": "#b5482e",
            "color": "#b5482e"
          }
        },
        {
          "id": "l_body",
          "type": "label",
          "text": "Cylinder",
          "attach_to": "body",
          "side": "right"
        },
        {
          "id": "l_piston",
          "type": "label",
          "text": "Piston",
          "attach_to": "piston",
          "side": "right"
        },
        {
          "id": "l_valve",
          "type": "label",
          "text": "One-way valve",
          "attach_to": "valve",
          "side": "right"
        },
        {
          "id": "pumpe",
          "type": "group",
          "members": [
            "body",
            "plunger",
            "hose",
            "valve"
          ],
          "fit": "left"
        }
      ],
      "commands": [
        {
          "card": {
            "title": "Inside a bicycle pump"
          }
        },
        {
          "draw": [
            "pumpe",
            "l_body",
            "l_piston",
            "l_valve"
          ],
          "speak": "A pump pushes air into a tyre already tighter than the air outside. Why does none of it come back?"
        },
        {
          "pause": 0.4
        },
        {
          "highlight": {
            "target": [
              "piston"
            ],
            "effect": "glow"
          },
          "speak": "The piston seals the tube, trapping a column of ordinary air beneath it."
        },
        {
          "move": {
            "target": "plunger",
            "to": {
              "ref": "body",
              "anchor": "center"
            },
            "anchor": "bottom",
            "duration": 1.6
          },
          "speak": "Push down, and that air is squeezed into half the space, so its pressure climbs past the tyre's."
        },
        {
          "point": {
            "at": {
              "ref": "valve"
            },
            "gesture": "circle"
          },
          "speak": "At the end of the hose sits a flap that only the higher pressure can push open."
        },
        {
          "highlight": {
            "target": [
              "valve"
            ],
            "effect": "pulse"
          },
          "speak": "Let go, and the tyre's own pressure slams it shut. Each stroke adds air and none returns: the pump never holds the pressure — the valve does."
        }
      ]
    }
  },
  {
    "request": "Why does a dropped ball speed up? Show the equations with the curve.",
    "spec": {
      "title": "Why a falling ball stops speeding up",
      "domain": {
        "x": [
          0,
          12
        ],
        "y": [
          0,
          70
        ]
      },
      "elements": [
        {
          "id": "ax",
          "type": "axes",
          "x_label": "Time falling (s)",
          "y_label": "Speed (m/s)"
        },
        {
          "id": "vac",
          "type": "curve",
          "expr": "9.8*x",
          "x_to": 7,
          "style": {
            "color": "#8f887c",
            "dash": true
          }
        },
        {
          "id": "lab_vac",
          "type": "label",
          "text": "gravity alone",
          "attach_to": "vac",
          "side": "left"
        },
        {
          "id": "eq_v",
          "type": "math",
          "tex": "v = g\\,t",
          "size": 48,
          "x": 230,
          "y": 560
        },
        {
          "id": "real",
          "type": "curve",
          "expr": "42*(1 - exp(-9.8*x/42))",
          "style": {
            "color": "#b5482e"
          }
        },
        {
          "id": "term",
          "type": "curve",
          "expr": "42",
          "style": {
            "color": "#2f6b8f",
            "dash": true
          }
        },
        {
          "id": "lab_term",
          "type": "label",
          "text": "terminal speed, 42 m/s",
          "attach_to": "term",
          "side": "above"
        },
        {
          "id": "eq_F",
          "type": "math",
          "tex": "F_{\\text{net}} = mg - k v^2",
          "size": 48,
          "x": 700,
          "y": 280
        }
      ],
      "commands": [
        {
          "card": {
            "title": "Why a falling ball stops speeding up"
          }
        },
        {
          "draw": [
            "ax"
          ],
          "speak": "Drop a baseball and it falls faster and faster — but not forever. Two forces explain both halves."
        },
        {
          "draw": [
            "vac",
            "lab_vac"
          ],
          "speak": "Gravity pulls with the same force all the way down, so it adds the same speed every second: 9.8 metres per second, each second."
        },
        {
          "draw": [
            "eq_v"
          ],
          "speak": "With nothing else acting, speed simply grows with time."
        },
        {
          "pause": 0.3
        },
        {
          "draw": [
            "real"
          ],
          "speak": "A real ball starts on that line, then falls behind it and levels off."
        },
        {
          "draw": [
            "eq_F"
          ],
          "speak": "The second force is the air. The ball has to shove air out of its way, and the faster it goes, the harder the air pushes back — roughly with the square of the speed."
        },
        {
          "highlight": {
            "target": [
              "eq_F"
            ],
            "part": "k v^2"
          },
          "speak": "So the net pull shrinks as the ball speeds up, and each second adds less speed than the one before."
        },
        {
          "draw": [
            "term",
            "lab_term"
          ],
          "speak": "At about 42 metres per second — 150 kilometres an hour — the air pushes up as hard as gravity pulls down. No net force, no more speeding up: terminal speed."
        },
        {
          "highlight": {
            "target": [
              "vac"
            ]
          },
          "speak": "On the Moon, with no air, the ball would stay on the straight line all the way down."
        },
        {
          "quiz": {
            "question": "A feather and a baseball are dropped together. Why does the feather lag?",
            "choices": [
              "Gravity pulls it less per kilo",
              "The air stops it speeding up much sooner"
            ],
            "correct": 2,
            "right": "Gravity adds the same 9.8 m/s each second to both; the feather's air resistance matches its tiny weight almost at once."
          }
        }
      ]
    }
  },
  {
    "request": "What does a wind turbine's gearbox actually do?",
    "spec": {
      "title": "Inside the nacelle",
      "elements": [
        {
          "id": "tower",
          "type": "polygon",
          "points": [
            [
              -22,
              0
            ],
            [
              22,
              0
            ],
            [
              13,
              330
            ],
            [
              -13,
              330
            ]
          ]
        },
        {
          "id": "nacelle",
          "type": "shape",
          "shape": "rect",
          "width": 170,
          "height": 60,
          "at": {
