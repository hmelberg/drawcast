[
  {
    "request": "Draw a demand and supply diagram, then show demand increasing.",
    "spec": {
      "title": "Demand increase",
      "template": "supply_demand",
      "params": {
        "demand": { "curvature": "linear", "label": "D" },
        "supply": { "label": "S" },
        "equilibrium": { "show": true, "guides": true },
        "demand_shift": { "direction": "right", "label": "D′" }
      },
      "commands": [
        { "speak": "Let's build a market diagram and find where the price settles." },
        { "draw": ["axes"], "speak": "Price on the vertical axis, quantity on the horizontal." },
        { "pause": 0.3 },
        { "draw": ["demand_curve", "label_D"], "speak": "This falling line is demand: as price falls, quantity demanded rises." },
        { "pause": 0.3 },
        { "draw": ["supply_curve", "label_S"], "speak": "And this rising line is supply: higher prices call forth more production." },
        { "pause": 0.3 },
        { "draw": ["equilibrium_point", "guide_lines", "label_E", "label_Pstar", "label_Qstar"], "speak": "Where the two lines cross, the market clears." },
        { "point": { "at": { "ref": "equilibrium_point" }, "gesture": "circle" }, "speak": "This is the equilibrium." },
        { "pause": 0.5 },
        { "draw": ["demand_shift_curve", "demand_shift_arrow", "label_D_shift"], "speak": "Now suppose demand increases: the whole curve shifts to the right." },
        { "highlight": { "target": ["demand_shift_curve"], "effect": "pulse" } }
      ]
    }
  },
  {
    "request": "Draw a decision tree for choosing between surgery and watchful waiting, with QALY payoffs.",
    "spec": {
      "title": "Surgery vs watchful waiting",
      "template": "decision_tree",
      "params": {
        "root": {
          "id": "choice",
          "type": "decision",
          "label": "Choose strategy",
          "children": [
            {
              "label": "Surgery",
              "node": {
                "id": "surgery",
                "type": "chance",
                "label": "Operate",
                "children": [
                  { "label": "Success", "probability": 0.85, "node": { "id": "ok", "type": "terminal", "label": "Recovered", "payoff": 9.2 } },
                  { "label": "Complication", "probability": 0.15, "node": { "id": "comp", "type": "terminal", "label": "Complication", "payoff": 5.1 } }
                ]
              }
            },
            { "label": "Watchful waiting", "node": { "id": "wait", "type": "terminal", "label": "No operation", "payoff": 7.4 } }
          ]
        }
      },
      "elements": [
        { "id": "rule_out", "type": "annotation", "target": "label_wait", "kind": "strike" }
      ],
      "commands": [
        { "speak": "The choice: operate, or wait. Let's map the decision." },
        { "draw": ["node_choice", "label_choice"], "speak": "This square is the decision we control: operate, or wait." },
        { "pause": 0.3 },
        { "draw": ["edge_choice_surgery", "branchlabel_choice_surgery", "node_surgery", "label_surgery"], "speak": "Surgery leads to a circle — a chance node — because the outcome is uncertain." },
        { "pause": 0.3 },
        { "draw": ["edge_surgery_ok", "branchlabel_surgery_ok", "node_ok", "label_ok", "payoff_ok", "edge_surgery_comp", "branchlabel_surgery_comp", "node_comp", "label_comp", "payoff_comp"], "speak": "With probability 0.85 the operation succeeds; with 0.15 there is a complication." },
        { "highlight": { "target": ["payoff_ok", "payoff_comp"], "effect": "circle" }, "speak": "The payoffs: 9.2 QALYs after recovery, 5.1 after a complication." },
        { "pause": 0.3 },
        { "draw": ["edge_choice_wait", "branchlabel_choice_wait", "node_wait", "label_wait", "payoff_wait"], "speak": "Watchful waiting avoids the risk, at a lower expected payoff." },
        { "pause": 0.3 },
        { "draw": ["rule_out"], "speak": "Expected value favours surgery — about 8.6 against 7.4 QALYs — so we rule out waiting." }
      ]
    }
  },
  {
    "request": "Illustrate diminishing marginal utility.",
    "spec": {
      "title": "Diminishing marginal utility",
      "domain": { "x": [0, 10], "y": [0, 100] },
      "elements": [
        { "id": "ax", "type": "axes", "x_label": "Quantity consumed", "y_label": "Total utility" },
        { "id": "utility", "type": "curve", "expr": "100*(1 - exp(-0.4*x))", "style": { "color": "#2f6b8f" } },
        { "id": "u_label", "type": "label", "text": "U(x)", "attach_to": "utility", "side": "above" },
        { "id": "p1", "type": "point", "at": { "x": 2, "y": 55.1 }, "guides": true },
        { "id": "p2", "type": "point", "at": { "x": 6, "y": 90.9 }, "guides": true },
        { "id": "note", "type": "label", "text": "Each extra unit adds less", "attach_to": "p2", "side": "below-right" },
        { "id": "mark_note", "type": "annotation", "target": "note", "kind": "box" }
      ],
      "commands": [
        { "speak": "Let's see why the first unit we consume matters more than the sixth." },
        { "draw": ["ax", "utility", "u_label"], "speak": "Total utility rises as we consume more — but the curve keeps flattening." },
        { "pause": 0.3 },
        { "draw": ["p1", "p2"], "parallel": true, "speak": "The first two units bring utility to 55; the next four only lift it to 91." },
        { "highlight": { "target": ["p1", "p2"], "effect": "circle" }, "speak": "The same extra unit buys less and less." },
        { "pause": 0.3 },
        { "draw": ["note", "mark_note"], "speak": "That flattening is diminishing marginal utility." }
      ]
    }
  },
  {
    "request": "Show a client sending a request to a server that queries a database.",
    "spec": {
