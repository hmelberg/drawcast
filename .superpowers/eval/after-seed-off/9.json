 ],
 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "Splayed feet, a needle top, a curve between them — every guess about that shape is usually the wrong one."
  },
  {
   "draw": [
    "ground",
    "leg_left",
    "leg_right",
    "arch",
    "plat1",
    "plat2",
    "plat3",
    "spire"
   ],
   "speak": "Three hundred metres of iron lattice on four feet, spread a hundred metres apart."
  },
  {
   "pause": 0.4
  },
  {
   "highlight": {
    "target": [
     "leg_left",
     "leg_right"
    ],
    "effect": "glow"
   },
   "speak": "The natural guess is that the wide base carries the weight — but weight is the easy part here."
  },
  {
   "point": {
    "at": {
     "ref": "ground"
    },
    "gesture": "underline"
   },
   "speak": "Seven thousand tonnes, shared among four feet, press the ground about as hard as a person on a chair."
  },
  {
   "draw": [
    "wind_1",
    "wind_2",
    "wind_3",
    "wind_4",
    "l_wind"
   ],
   "parallel": true,
   "speak": "The dangerous load comes sideways: wind, pushing on an open lattice all the way up."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "eiffel"
   ],
   "speak": "Gustave Eiffel had built wind-loaded iron all his life — railway viaducts, and the skeleton inside the Statue of Liberty."
  },
  {
   "erase": [
    "eiffel"
   ],
   "speak": "His rule for the outline was almost embarrassingly simple."
  },
  {
   "draw": [
    "tan_left",
    "tan_right",
    "meet",
    "l_meet"
   ],
   "speak": "At every height, the tangents to the two uprights must cross where all the wind above is pushing."
  },
  {
   "draw": [
    "resultant"
   ],
   "speak": "Obey that, and the wind's push runs straight down the line of each leg."
  },
  {
   "highlight": {
    "target": [
     "leg_left",
     "leg_right"
    ],
    "effect": "glow"
   },
   "speak": "Nothing bends and nothing pries at the joints — only compression, which iron takes without complaint."
  },
  {
   "draw": [
    "l_conclusion",
    "mark"
   ],
   "speak": "So the flare is neither taste nor decoration: the silhouette is the wind load itself, solved and then built.",
   "delivery": "grave"
  },
  {
   "speak": "And it holds — in a gale the top shifts about a hand's width, less than the sun moves it by warming one side."
  }
 ]
}