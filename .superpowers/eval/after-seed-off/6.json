 "commands": [
  {
   "draw": [
    "tittel"
   ],
   "speak": "De fleste gjetter for lavt på hva sparepengene blir — og gjetter derfor også feil på hva lånet koster."
  },
  {
   "draw": [
    "ax"
   ]
  },
  {
   "draw": [
    "simple",
    "l_simple"
   ],
   "speak": "Ti tusen kroner til sju prosent: tar du renta ut hvert år, får du 700 kroner, og linja stiger like mye hele veien."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "p_simple",
    "lab_simple_val"
   ],
   "speak": "Etter tretti år står det 31 000 kroner."
  },
  {
   "draw": [
    "compound",
    "l_compound"
   ],
   "speak": "Lar du renta stå, tjener den selv renter neste år — og kurven bøyer oppover."
