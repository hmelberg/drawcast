 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "Stortingsbygningen har en rund utbuling midt i fasaden — og den utbulingen forklarer hele huset."
  },
  {
   "draw": [
    "ground",
    "wing_left",
    "wing_right",
    "win_left",
    "win_right"
   ],
   "speak": "To symmetriske fløyer i gul teglstein strekker seg ut mot hver side."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "tower",
    "win2",
    "win1",
    "win3",
    "dome",
    "stairs"
   ],
   "speak": "Og midtpartiet skyter fram mot gata, rundt som et halvt tårn, med rundbuede vinduer."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "langlet"
   ],
   "speak": "Tegningene er av svensken Emil Victor Langlet, som vant arkitektkonkurransen; huset stod ferdig i 1866."
  },
  {
   "erase": [
    "langlet"
   ],
   "speak": "Men hvorfor er nettopp midten rund?"
  },
  {
   "point": {
    "at": {
     "ref": "dome"
    },
    "gesture": "circle"
   },
   "speak": "Buen er ikke pynt — den er en vegg som presses utover fra innsiden."
  },
  {
   "draw": [
    "sal",
    "l_sal"
   ],
   "speak": "For sett rett ovenfra er stortingssalen en halvsirkel: et amfi."
  },
  {
   "draw": [
    "row1",
    "row2",
    "row3"
   ],
   "parallel": true,
   "speak": "Benkeradene bøyer seg rundt ett felles midtpunkt."
  },
  {
   "draw": [
    "president",
    "l_pres"
   ],
   "speak": "I det punktet, ved den rette veggen, står presidenten og talerstolen."
  },
  {
   "draw": [
    "wedge1",
    "wedge2",
    "l_wedge"
   ],
   "speak": "Representantene sitter ikke partivis, men fylkesvis — hvert valgdistrikt samlet i sin kile av salen."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "link"
   ],
   "speak": "Og denne buede ytterveggen er den samme buen du ser ute i fasaden."
  },
  {
   "highlight": {
    "target": [
     "dome",
     "sal"
    ],
    "effect": "glow"
   },
   "speak": "Amfiet gjør at alle vender innover mot hverandre — ikke i to fronter mot hverandre, slik benkene står i britiske Underhuset."
  },
  {
   "draw": [
    "mark"
   ],
   "speak": "Så huset er formet av rommet: den runde fasaden er rett og slett stortingssalen sett fra utsiden."
  }
 ]
}