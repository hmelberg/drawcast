 "commands": [
  {
   "draw": [
    "tittel"
   ],
   "speak": "Voks er det dyreste bien lager — hun må spise mange ganger så mye honning for å svette ut ett gram."
  },
  {
   "draw": [
    "foto"
   ],
   "speak": "Så hver vegg hun sparer, er honning hun beholder — og alle cellene i kaka er sekskanter."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "tri",
    "l_tri",
    "kvad",
    "l_kvad",
    "heks",
    "l_heks"
   ],
   "speak": "Tre celleformer med nøyaktig samme areal — like mye plass til honning i hver."
  },
  {
   "draw": [
    "m_tri",
    "m_kvad",
    "m_heks"
   ],
   "parallel": true,
   "speak": "Men veggen rundt dem er ikke like lang."
  },
  {
   "highlight": {
    "target": [
     "heks",
     "m_heks"
    ],
    "effect": "glow"
   },
   "speak": "Sekskanten gjerder inn samme areal med kortest vegg av de tre."
  },
  {
   "draw": [
    "mark"
   ],
   "speak": "Og vegg er voks."
  },
  {
   "pause": 0.4
  },
  {
   "erase": [
    "tri",
    "l_tri",
    "m_tri",
    "kvad",
    "l_kvad",
    "m_kvad"
   ],
   "speak": "Bare disse tre formene fyller en flate uten hull igjen — sirkler ville latt luft stå igjen mellom cellene."
  },
  {
   "draw": [
    "c1",
    "c2",
    "c3",
    "c4",
    "c5",
    "c6",
    "c7"
   ],
   "parallel": true,
   "speak": "Så hun bygger celle etter celle av samme form."
  },
  {
   "arrange": {
    "target": [
     "c1",
     "c2",
     "c3",
     "c4",
     "c5",
     "c6",
     "c7"
    ],
    "layout": "hex",
    "at": [
     480,
     170
    ],
    "gap": 0,
    "duration": 2.5
   },
   "speak": "Presset sammen deler naboene vegg, så hver vegg bygges bare én gang."
  },
  {
   "point": {
    "at": {
     "ref": "foto"
    },
    "gesture": "circle"
   },
   "speak": "Mønsteret i fotografiet er nøyaktig denne skissen."
  },
  {
   "highlight": {
    "target": [
     "c1",
     "c3",
     "c5"
    ],
    "effect": "pulse"
   },
   "speak": "At ingen annen oppdeling i det hele tatt slår sekskantene — heller ikke en med buede vegger — ble først bevist av Thomas Hales i 1999."
  },
  {
   "speak": "Sekskanten er altså ikke pynt: den er den billigste måten å dele opp en flate på.",
   "delivery": "grave"
  }
