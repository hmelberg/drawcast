 "commands": [
  {
   "draw": [
    "title",
    "base",
    "column",
    "arm",
    "head"
   ],
   "speak": "Håndsøm drar tråden helt gjennom stoffet. Det klarer ikke en symaskin – og hele maskinen er bygget rundt den umuligheten."
  },
  {
   "draw": [
    "handwheel",
    "l_wheel"
   ],
   "speak": "Håndhjulet på høyre side driver alt sammen; motoren inni gjør nøyaktig det samme, bare rundt tusen ganger i minuttet."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "spool_pin",
    "spool",
    "l_spool"
   ],
   "speak": "Øverst står trådsnella med overtråden."
  },
  {
   "draw": [
    "thread",
    "tension",
    "l_tension"
   ],
   "speak": "Tråden løper ned gjennom trådstrammeren – to skiver som klemmer akkurat hardt nok til at stinget verken blir løst eller rynkete."
  },
  {
   "draw": [
    "takeup",
    "l_takeup"
   ],
   "speak": "Så over trådgiveren, spaken som mater ut tråd på vei ned og rykker den stram igjen på vei opp."
  },
  {
   "flow": {
    "along": [
     "thread"
    ]
   },
   "speak": "Fra snelle til nålespiss er dette én sammenhengende vei."
  },
  {
   "draw": [
    "needle",
    "l_needle"
   ],
   "speak": "Nåla har øyet nede ved spissen, ikke oppe – den lille vrien er selve oppfinnelsen bak symaskinen."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "fabric",
    "presser",
    "l_fabric",
    "l_presser"
   ],
   "speak": "Trykkfoten holder stoffet flatt mot stingplata, så det ikke følger med nåla opp igjen."
  },
  {
   "draw": [
    "feed",
    "l_feed"
   ],
   "speak": "Transportøren under, disse små tennene, drar stoffet ett hakk fram mellom hvert sting – det er maskinen som bestemmer stinglengden, ikke hånda di."
  },
  {
   "draw": [
    "bobbin",
    "l_bobbin"
   ],
   "speak": "Og nede i bunnplata ligger spolen, med sin helt egen tråd."
  },
  {
   "camera": {
    "center": {
     "ref": "bobbin"
    },
    "zoom": 2.2
   },
   "speak": "Her nede skjer det avgjørende."
  },
  {
   "draw": [
    "loop"
   ],
   "speak": "Nåla stikker bare ned og opp igjen, og etterlater en liten løkke av overtråd under stoffet."
  },
  {
   "draw": [
    "bobbin_thread"
   ],
   "speak": "En griper svinger spoletråden tvers gjennom den løkka."
  },
  {
   "draw": [
    "mark_lock"
   ],
   "speak": "Trådgiveren rykker løkka opp, og de to trådene låses i hverandre midt inne i stoffet – et låsesting.",
   "delivery": "grave"
  },
  {
   "camera": {
    "reset": true
   }
  },
  {
   "draw": [
    "stitches"
   ],
   "speak": "Sting etter sting, hver eneste ett en knute mellom overtråd og undertråd."
  },
  {
   "speak": "Nå ser du hvorfor en symaskin alltid trenger to tråder: nåla kommer aldri gjennom stoffet – den lager bare løkka, og spolen under knyter den fast."
  }
 ]
}