 "commands": [
  {
   "draw": [
    "title",
    "body"
   ],
   "speak": "Nesten alt som går galt ved en symaskin — knuter, hopp, tråd som ryker — sitter i én av få deler, så det lønner seg å vite hva hver gjør."
  },
  {
   "draw": [
    "spool_pin",
    "spool",
    "label_spool"
   ],
   "speak": "Øverst står trådsnellen: herfra kommer overtråden."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "tension",
    "label_tension"
   ],
   "speak": "Tråden går gjennom trådspenningen, to skiver som klemmer akkurat passe — for løst, og du får løkker under stoffet."
  },
  {
   "draw": [
    "takeup",
    "label_takeup"
   ],
   "speak": "Trådgiveren vipper opp og strammer tråden etter hvert eneste sting."
  },
  {
   "draw": [
    "thread_upper"
   ],
   "speak": "Slik løper overtråden hele veien ned til nåla."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "needle_bar",
    "needle",
    "label_needle"
   ],
   "speak": "Og nåla har øyet nederst, i spissen — ikke øverst som en håndsynål."
  },
  {
   "draw": [
    "howe"
   ],
   "speak": "Det lille flyttet var selve gjennombruddet: Elias Howe patenterte låsesting-maskinen i 1846, med øyet nede i spissen."
  },
  {
   "erase": [
    "howe"
   ]
  },
  {
   "draw": [
    "fabric",
    "presser_foot",
    "label_presser"
   ],
   "speak": "Trykkfoten presser stoffet ned mot platen, så det ikke blir med nåla opp igjen."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "feed_dog",
    "label_feed"
   ],
   "speak": "Under platen løfter transportørens tenner seg, drar stoffet et hakk fram, og senker seg."
  },
  {
   "draw": [
    "feed_arrow",
    "label_feed_dir"
   ],
   "speak": "Maskinen mater altså stoffet selv — dytter du på, blir stingene ujevne."
  },
  {
   "draw": [
    "bobbin",
    "label_bobbin"
   ],
   "speak": "Nede i basen ligger spolen med undertråden, den du aldri ser ovenfra."
  },
  {
   "draw": [
    "handwheel",
    "label_handwheel"
   ],
   "speak": "Håndhjulet driver alt sammen, så nål, trådgiver og transportør beveger seg i samme takt."
  },
  {
   "pause": 0.5
  },
  {
   "draw": [
    "inset_fabric",
    "inset_upper",
    "label_over"
   ],
   "speak": "Helt tett på: nåla dytter overtråden ned og etterlater en løkke under stoffet."
  },
  {
   "draw": [
    "inset_lower",
    "label_under"
   ],
   "speak": "En griper fanger løkka og kaster undertråden tvers gjennom den."
  },
  {
   "draw": [
    "inset_caption",
    "mark"
   ],
   "speak": "De to trådene låser hverandre inne i stoffet — et låsesting."
  },
  {
   "highlight": {
    "target": [
     "spool",
     "bobbin"
    ],
    "effect": "glow"
   },
   "speak": "Ingen tråd dras noen gang hel gjennom stoffet; nåla stikker bare ned og opp, og to tråder gjør resten."
  },
  {
   "speak": "Derfor klarer maskinen tusen sting i minuttet — og derfor er nesten hver feil enten spenningen, spolen eller trykkfoten.",
   "delivery": "grave"
  }
 ]
}