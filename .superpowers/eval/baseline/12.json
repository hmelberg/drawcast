    ]
   }
  },
  {
   "draw": [
    "plan_hall",
    "plan_label"
   ],
   "speak": "Sett ovenfra er salen en halvsirkel, med den buede veggen ut mot gaten."
  },
  {
   "draw": [
    "rostrum",
    "rostrum_label"
   ],
   "speak": "På den rette veggen står presidentens plass."
  },
  {
   "draw": [
    "seat_1",
    "seat_2",
    "seat_3"
   ],
   "parallel": true,
   "speak": "Benkeradene bøyer seg rundt i et amfi: 169 representanter, alle vendt mot samme punkt."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "painting",
    "painting_label"
   ],
   "speak": "Bak presidenten henger Oscar Wergelands maleri av Eidsvollsforsamlingen fra 1885 — de som skrev grunnloven ser ned på dem som bruker den."
  },
  {
   "draw": [
    "bench_a",
    "bench_b",
    "bench_label"
   ],
   "speak": "I Westminster sitter regjering og opposisjon i rette rader rett mot hverandre."
  },
  {
   "focus": {
    "target": [
     "plan_hall",
     "seat_1",
     "seat_2",
     "seat_3",
     "rostrum"
    ]
   },
   "speak": "Halvsirkelen sier noe annet: ikke to fronter mot hverandre, men én forsamling som møtes i et felles brennpunkt."
  },
  {
   "draw": [
    "conclusion",
    "mark"
   ],
   "speak": "Så kuppelen ute på Karl Johans gate er selve salens form — og et bilde av debatten den ble bygget for."
  }
