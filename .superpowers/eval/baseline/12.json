 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "Et parlamentsbygg avgjør hvem som ser hvem under en debatt — og Stortinget er tegnet med et bestemt svar."
  },
  {
   "draw": [
    "ground",
    "street"
   ]
  },
  {
   "draw": [
    "axis_line",
    "wing_l",
    "wing_r",
    "pav_l",
    "pav_r"
   ],
   "speak": "Fasaden mot Karl Johans gate er strengt symmetrisk om en midtakse: to like fløyer med hver sin endepaviljong."
  },
  {
   "draw": [
    "win_l",
    "win_r"
   ],
   "parallel": true
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "center",
    "dome",
    "finial"
   ],
   "speak": "Midt i aksen skyter en rund bygningskropp fram, kronet av en kuppel."
  },
  {
   "draw": [
    "win_c",
    "door"
   ]
  },
  {
   "draw": [
    "langlet"
   ],
   "speak": "Huset stod ferdig i 1866, etter en arkitektkonkurranse vunnet av svensken Emil Victor Langlet."
  },
  {
   "speak": "Gul teglstein på granittsokkel, med former lånt fra romansk og italiensk arkitektur.",
   "delivery": "soft"
  },
  {
   "erase": [
    "langlet"
   ],
   "speak": "Men det avgjørende ligger i den runde midtdelen."
  },
  {
   "highlight": {
    "target": [
     "center",
     "dome"
    ],
    "effect": "glow"
   },
   "speak": "Den er ikke dekor — det er stortingssalen selv som presser seg ut i fasaden."
  },
  {
   "draw": [
    "hall_note"
   ]
  },
  {
   "camera": {
    "center": {
     "ref": "dome"
    },
    "zoom": 1.7
   },
   "speak": "Formen på rommet er blitt formen på huset.",
   "delivery": "grave"
  },
  {
   "camera": {
    "reset": true
   }
  },
  {
   "clear": {
    "keep": [
