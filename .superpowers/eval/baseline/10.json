 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "Voks er dyrt for et bifolk: de må spise mange ganger så mye honning som voksen de lager veier."
  },
  {
   "draw": [
    "tri",
    "sq",
    "hexa",
    "circ"
   ],
   "parallel": true,
   "speak": "Her er fire mulige celleformer, alle med nøyaktig samme areal — like mye plass til honning."
  },
  {
   "draw": [
    "n_tri",
    "n_sq",
    "n_hex",
    "n_circ",
    "p_tri",
    "p_sq",
    "p_hex",
    "p_circ"
   ],
   "parallel": true,
   "speak": "Men veggen som må bygges, er ikke like lang: 4,56, 4,00, 3,72 og 3,54 centimeter."
  },
  {
   "highlight": {
    "target": [
     "circ"
    ],
    "effect": "glow"
   },
   "speak": "Sirkelen er den aller billigste — minst vegg for arealet den stenger av."
  },
  {
   "draw": [
    "cross_circ"
   ],
   "speak": "Men sirkler kan ikke ligge tett inntil hverandre; mellom dem blir det hull, og hull rommer ingen honning."
  },
  {
   "highlight": {
    "target": [
     "tri",
     "sq"
    ],
    "effect": "pulse"
   },
   "speak": "Trekant og kvadrat fyller flaten helt, men sløser med vegg."
  },
  {
   "erase": [
    "cross_circ",
    "circ",
    "tri",
    "sq",
    "n_tri",
    "n_sq",
    "n_circ",
    "p_tri",
    "p_sq",
    "p_circ"
   ]
  },
  {
   "draw": [
    "hex_1"
   ],
   "speak": "Sekskanten er kompromisset: nesten så rund som mulig, og likevel helt tettpakket."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "hex_2",
    "hex_3",
    "hex_4",
    "hex_5",
    "hex_6",
    "hex_7",
    "hex_8",
    "hex_9",
    "hex_10",
    "hex_11",
    "hex_12"
   ],
   "parallel": true,
   "speak": "Gi hver larve sin egen celle, og biene bygger dem side om side."
  },
  {
   "arrange": {
    "target": [
     "hex_1",
     "hex_2",
     "hex_3",
     "hex_4",
     "hex_5",
     "hex_6",
     "hex_7",
     "hex_8",
     "hex_9",
     "hex_10",
     "hex_11",
     "hex_12"
    ],
    "layout": "hex",
    "at": [
     500,
     250
    ],
    "gap": 0,
    "duration": 2.5
   },
   "speak": "De faller sammen uten et eneste mellomrom, og hver vegg deles av to celler — så voksen teller dobbelt."
  },
  {
   "pause": 0.5
  },
  {
   "draw": [
    "ang120"
   ],
   "speak": "Der tre celler møtes, står veggene på 120 grader; tre slike hjørner blir nøyaktig 360."
  },
  {
   "draw": [
    "darwin"
   ],
   "speak": "Darwin viet cellebyggingen et eget avsnitt i «Artenes opprinnelse», og kalte den det mest fantastiske av alle kjente instinkter."
  },
  {
   "erase": [
    "darwin"
   ],
   "speak": "At sekskantnettet virkelig er det sparsommeligste av alle mulige mønstre, ble først bevist i 1999, av matematikeren Thomas Hales."
  },
  {
   "highlight": {
    "target": [
     "hex_1",
     "hex_2",
     "hex_3",
     "hex_4",
     "hex_5",
     "hex_6",
     "hex_7",
     "hex_8",
     "hex_9",
     "hex_10",
     "hex_11",
     "hex_12"
    ],
    "effect": "glow"
   },
   "speak": "Sekskanten vinner fordi den er nesten en sirkel — den eneste nesten-sirkelen som klarer å fylle flaten helt.",
   "delivery": "grave"
  }
 ]
