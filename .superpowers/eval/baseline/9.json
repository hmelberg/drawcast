 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "That famous flare: is it a style choice, or is it arithmetic?"
  },
  {
   "draw": [
    "ground",
    "leg_l",
    "leg_r",
    "cap",
    "mast",
    "arch",
    "plat1",
    "plat2",
    "plat3"
   ],
   "parallel": true,
   "speak": "Three hundred metres of iron, flaring hard at the feet and almost straight near the top."
  },
  {
   "pause": 0.4
  },
  {
   "highlight": {
    "target": [
     "ground"
    ],
    "effect": "glow"
   },
   "speak": "Its own weight is not the problem — spread over four feet, the tower presses the ground about as hard as a man sitting in a chair."
  },
  {
   "draw": [
    "wind1",
    "wind2",
    "wind3",
    "wind4"
   ],
   "parallel": true,
   "speak": "The enemy is wind, and it bites hardest high up, where every push works on a long lever."
  },
  {
   "draw": [
    "label_wind"
   ]
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "sect",
    "pt_p"
   ],
   "speak": "So cut the tower at some height and ask what the part above is doing to this edge."
  },
  {
   "draw": [
    "res",
    "wind_res",
    "label_res"
   ],
   "speak": "Every gust above the cut adds up to one single push, acting at one single point."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "tangent"
   ],
   "speak": "Eiffel's own stated rule was this: at each height, tilt the edge so it aims exactly at that point."
  },
  {
   "draw": [
    "thrust",
    "label_thrust",
    "mark"
   ],
   "speak": "Aimed that way, the wind's shove runs straight down the leg as squeezing — and wrought iron held by rivets hates being pulled far more than being squeezed."
  },
  {
   "pause": 0.5
  },
  {
   "draw": [
    "cone",
    "label_cone"
   ],
   "speak": "A straight taper would sit out here — for most of its height the real tower is actually thinner than that."
  },
  {
   "highlight": {
    "target": [
     "leg_l",
     "leg_r"
    ],
    "effect": "glow"
   },
   "speak": "Because the wind's leverage piles up as you descend, nearly all the widening is spent in the bottom fifty metres."
  },
  {
   "draw": [
    "label_lattice"
   ],
   "speak": "And the openwork finishes the job: most of the air simply passes through the lattice instead of leaning on it."
  },
  {
   "speak": "So the silhouette is not decoration — it is a graph of the wind's leverage, drawn in iron; in a full storm the top shifts only a hand's breadth, less than the sun bends it by warming one side.",
   "delivery": "grave"
  }
 ]
}