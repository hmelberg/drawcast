   3.4
  ],
  "y": [
   0,
   35
  ]
 },
 "elements": [
  {
   "id": "title",
   "type": "text",
   "text": "Why a dropped ball speeds up",
   "x": 500,
   "y": 712,
   "font_size": 34
  },
  {
   "id": "axes",
   "type": "axes",
   "x_label": "Time falling (s)",
   "y_label": "Speed (m/s)"
  },
  {
   "id": "ball",
   "type": "shape",
   "shape": "circle",
   "x": 180,
   "y": 655,
   "radius": 16,
   "style": {
    "fill": "#3d3833"
   }
  },
  {
   "id": "glabel",
   "type": "text",
   "text": "g",
   "x": 180,
   "y": 560,
   "font_size": 30,
   "style": {
    "color": "#b5482e"
   }
  },
  {
   "id": "garrow",
   "type": "arrow",
   "from": {
    "ref": "ball",
    "anchor": "bottom"
   },
   "to": {
    "ref": "glabel",
    "anchor": "top"
   },
   "style": {
    "color": "#b5482e"
   }
  },
  {
   "id": "eq1",
   "type": "text",
   "text": "a = g ≈ 10 m/s²  (constant)",
   "x": 420,
   "y": 645,
   "font_size": 30,
   "style": {
    "color": "#b5482e"
   }
  },
  {
   "id": "eq2",
   "type": "text",
   "text": "v = g · t",
   "x": 420,
   "y": 575,
   "font_size": 30,
   "style": {
    "color": "#2f6b8f"
   }
  },
  {
   "id": "mark_eq2",
   "type": "annotation",
   "target": "eq2",
   "kind": "box"
  },
  {
   "id": "eq3",
   "type": "text",
   "text": "s = ½ g · t²",
   "x": 420,
   "y": 505,
   "font_size": 30
  },
  {
   "id": "speed_curve",
   "type": "curve",
   "expr": "10*x",
   "x_from": 0,
   "x_to": 3.4,
   "style": {
    "color": "#2f6b8f"
   }
  },
  {
   "id": "label_v",
   "type": "label",
   "text": "speed of the ball",
   "attach_to": "speed_curve",
   "side": "below-right",
   "style": {
    "color": "#2f6b8f"
   }
  },
  {
   "id": "p1",
   "type": "point",
   "at": {
    "x": 1,
    "y": 10
   }
  },
  {
   "id": "p2",
   "type": "point",
   "at": {
    "x": 2,
    "y": 20
   }
  },
  {
   "id": "p3",
   "type": "point",
   "at": {
    "x": 3,
    "y": 30
   },
   "guides": true
  },
  {
   "id": "label_p3",
   "type": "label",
   "text": "30 m/s",
   "attach_to": "p3",
   "side": "above-left"
  }
 ],
 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "A ball dropped from a third-floor window lands three times faster than one dropped from your hand — the fall itself is what makes it dangerous."
  },
  {
   "draw": [
    "axes"
   ]
  },
  {
   "draw": [
    "ball"
   ],
   "speak": "Here is the ball, one instant after your hand opens."
  },
  {
   "draw": [
    "garrow",
    "glabel"
   ],
   "speak": "Gravity pulls it down, and that pull never stops and never weakens — it acts in every single instant of the fall."
  },
  {
   "draw": [
    "eq1"
   ],
   "speak": "A steady pull means a steady acceleration: about ten metres per second, added to the speed every second."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "speed_curve",
    "label_v"
   ],
   "speak": "Plot the speed against time and it climbs in a perfectly straight line."
  },
  {
   "draw": [
    "p1",
    "p2",
    "p3",
    "label_p3"
   ],
   "parallel": true,
   "speak": "Ten metres per second after one second, twenty after two, thirty after three."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "eq2",
    "mark_eq2"
   ],
   "speak": "That line is v equals g times t — the speed is simply gravity multiplied by how long it has been falling."
  },
  {
   "draw": [
    "eq3"
   ],
   "speak": "Distance behaves differently: it grows with time squared, so those same three seconds cost the ball forty-five metres of height."
  },
  {
   "highlight": {
    "target": [
     "eq1"
    ],
    "effect": "glow"
   },
   "speak": "And nothing in g mentions the ball's mass — which is why Dave Scott, standing on the Moon, dropped a hammer and a falcon feather and watched them hit the dust together."
  },
  {
   "point": {
    "at": {
     "ref": "speed_curve"
    },
    "gesture": "underline"
   },
   "speak": "So the ball speeds up not because it is falling, but because gravity keeps pushing long after the motion has begun."
  }
 ]
}