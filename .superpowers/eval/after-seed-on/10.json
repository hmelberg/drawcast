 "commands": [
  {
   "draw": [
    "tittel"
   ],
   "speak": "Voks er biens dyreste byggemateriale — hun må spise flere gram honning for hvert gram voks hun skiller ut."
  },
  {
   "draw": [
    "foto"
   ],
   "speak": "Så hver vegg i kuben er en regning, og de betaler den i sekskanter."
  },
  {
   "pause": 0.4
  },
  {
   "draw": [
    "tri",
    "kvad",
    "heks"
   ],
   "parallel": true,
   "speak": "Bare tre regelmessige figurer dekker en flate uten hull: trekant, kvadrat og sekskant."
  },
  {
   "highlight": {
    "target": [
     "tri",
     "kvad",
     "heks"
    ],
    "effect": "pulse"
   },
   "speak": "Alle tre er tegnet med nøyaktig samme areal — like romslige celler."
  },
  {
   "draw": [
    "l_tri",
    "l_kvad",
    "l_heks"
   ],
   "speak": "Men veggen rundt blir ulik: 4,56 for trekanten, 4,00 for kvadratet, 3,72 for sekskanten."
  },
  {
   "draw": [
    "mark"
   ],
   "speak": "Sekskanten gjerder inn samme plass med minst vegg — rundt syv prosent mindre voks enn kvadrater.",
   "delivery": "grave"
  },
  {
   "pause": 0.5
  },
