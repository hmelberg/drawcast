 ],
 "commands": [
  {
   "draw": [
    "title",
    "tower",
    "label_leg"
   ],
   "speak": "That flare at the bottom looks like decoration, or like a tower carrying its own weight — and both readings are wrong."
  },
  {
   "draw": [
    "weight_arrow",
    "label_weight"
   ],
   "speak": "Weight was the easy part: seven thousand tonnes press straight down, and wrought iron takes squeezing superbly."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "wind_hi",
    "wind_mid",
    "wind_lo",
    "label_wind"
   ],
   "parallel": true,
   "speak": "The threat was wind, shoving sideways on the tallest thing anyone had built."
  },
  {
   "draw": [
    "tip_arrow",
    "label_tip"
   ],
   "speak": "A gale never crushes such a tower; it tries to rotate it about the downwind feet."
  },
  {
   "point": {
    "at": {
     "ref": "wind_hi"
    },
    "gesture": "tap"
   },
   "speak": "And leverage grows with height — the same gust up here twists the base far harder than one near the ground."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "eiffel"
   ],
   "speak": "Gustave Eiffel put it flatly: the curves of the four uprights were determined by wind resistance."
  },
  {
   "erase": [
    "eiffel"
   ],
   "speak": "So read the legs as arithmetic rather than ornament."
  },
  {
   "draw": [
    "thrust_left",
    "thrust_right",
    "label_thrust"
   ],
   "speak": "Extend the legs upward from any height, and the two tangents meet at one point above."
  },
  {
   "highlight": {
    "target": [
     "thrust_left",
     "thrust_right"
    ],
    "effect": "glow"
   },
   "speak": "That point is where the wind above that level effectively pushes — so the gust runs down the legs as pure squeeze, with nothing left to bend them.",
   "delivery": "grave"
  },
  {
   "pause": 0.4
  },
  {
   "highlight": {
    "target": [
     "leg_left",
     "leg_right"
    ],
    "effect": "glow"
   },
   "speak": "Lower down there is more tower overhead catching wind, so the legs must lean out further — that growing lean is the curve."
  },
  {
   "point": {
    "at": {
     "ref": "mast",
     "anchor": "end"
    },
    "gesture": "tap"
   },
   "speak": "It works almost too well: a storm shifts the summit a few centimetres, while sunshine warming one flank leans it further than the wind ever does."
  },
  {
   "draw": [
    "takeaway",
    "mark"
   ],
   "speak": "You can now see the silhouette for what it is — the tower's own wind calculation, drawn in iron."
  }
 ]
}