{
 "title": "Inside a bicycle pump",
 "elements": [
  {
   "id": "title",
   "type": "text",
   "text": "How a bicycle pump beats the tyre",
   "x": 500,
   "y": 712,
   "font_size": 36
  },
  {
   "id": "body",
   "type": "shape",
   "shape": "rect",
   "x": 0,
   "y": 0,
   "width": 90,
   "height": 320
  },
  {
   "id": "piston",
   "type": "shape",
   "shape": "rect",
   "width": 74,
   "height": 26,
   "at": {
    "ref": "body",
    "anchor": "top"
   },
   "anchor": "top",
   "style": {
    "fill": "#2f6b8f",
    "color": "#2f6b8f"
   }
  },
  {
   "id": "rod",
   "type": "shape",
   "shape": "rect",
   "width": 10,
   "height": 110,
   "at": {
    "ref": "piston",
    "anchor": "top"
   },
   "anchor": "bottom"
  },
  {
   "id": "handle",
   "type": "shape",
   "shape": "rect",
   "width": 150,
   "height": 26,
   "at": {
    "ref": "rod",
    "anchor": "top"
   },
   "anchor": "bottom"
  },
  {
   "id": "plunger",
   "type": "group",
   "members": [
    "piston",
    "rod",
    "handle"
   ]
  },
  {
   "id": "hose",
   "type": "path",
   "points": [
    [
     0,
     0
    ],
    [
     90,
     -40
    ],
    [
     210,
     -70
    ]
   ],
   "smooth": true,
   "at": {
    "ref": "body",
    "anchor": "bottom_right"
   },
   "anchor": "top_left"
  },
  {
   "id": "valve",
   "type": "shape",
   "shape": "circle",
   "radius": 16,
   "at": {
    "ref": "hose",
    "anchor": "end"
   },
   "style": {
    "fill": "#b5482e",
    "color": "#b5482e"
   }
  },
  {
   "id": "tyre_wall",
   "type": "path",
   "points": [
    [
     0,
     0
    ],
    [
     50,
     -55
    ],
    [
     50,
     -125
    ],
    [
     0,
     -180
    ]
   ],
   "smooth": true,
   "at": {
    "ref": "valve",
    "side": "right",
    "gap": 10
   },
   "anchor": "left",
   "style": {
    "color": "#8f887c"
   }
  },
  {
   "id": "l_body",
   "type": "label",
   "text": "Cylinder of trapped air",
   "attach_to": "body",
   "side": "left"
  },
  {
   "id": "l_piston",
   "type": "label",
   "text": "Piston with cup seal",
   "attach_to": "piston",
   "side": "right",
   "style": {
    "color": "#2f6b8f"
   }
  },
  {
   "id": "l_valve",
   "type": "label",
   "text": "One-way valve",
   "attach_to": "valve",
   "side": "below",
   "style": {
    "color": "#b5482e"
   }
  },
  {
   "id": "l_tyre",
   "type": "label",
   "text": "Tyre",
   "attach_to": "tyre_wall",
   "side": "right"
  },
  {
   "id": "pumpe",
   "type": "group",
   "members": [
    "body",
    "plunger",
    "hose",
    "valve",
    "tyre_wall"
   ],
   "fit": {
    "x": 60,
    "y": 110,
    "w": 460,
    "h": 550
   }
  },
  {
   "id": "eq",
   "type": "math",
   "tex": "P_1 V_1 = P_2 V_2",
   "size": 32,
   "x": 730,
   "y": 520
  },
  {
   "id": "punchline",
   "type": "text",
   "text": "Each stroke adds air.\nNone returns.",
   "x": 700,
   "y": 260,
   "font_size": 26
  },
  {
   "id": "mark",
   "type": "annotation",
   "target": "punchline",
   "kind": "box"
  }
 ],
 "commands": [
  {
   "draw": [
    "title"
   ],
   "speak": "A tyre holds air at four times the pressure of the room — pushing more in should be like blowing into a bottle that blows back."
  },
  {
   "draw": [
    "body",
    "hose",
    "tyre_wall",
    "l_body",
    "l_tyre"
   ],
   "speak": "The pump is little more than a sealed tube with a hose to the tyre."
  },
  {
   "draw": [
    "plunger",
    "l_piston"
   ],
   "speak": "A piston seals the tube, trapping a column of perfectly ordinary room-pressure air beneath it."
  },
  {
   "pause": 0.3
  },
  {
   "move": {
    "target": [
     "plunger"
    ],
    "to": {
     "ref": "body",
     "anchor": "center"
    },
    "anchor": "bottom",
    "duration": 1.6
   },
   "speak": "Push down, and that same air is forced into half the room it had."
  },
  {
   "draw": [
    "eq"
   ],
   "speak": "Halve the space and the pressure doubles; squeeze to a quarter and it quadruples — enough to beat the tyre."
  },
  {
   "draw": [
    "valve",
    "l_valve"
   ],
   "speak": "At the tyre sits a flap that opens only when the pressure behind it wins that contest."
  },
  {
   "flow": {
    "along": [
     "hose"
    ]
   },
   "speak": "So air pours in — but only during the part of the stroke where you are pushing hardest."
  },
  {
   "move": {
    "target": [
     "plunger"
    ],
    "to": {
     "ref": "body",
     "anchor": "top"
    },
    "anchor": "top",
    "duration": 1.4
   },
   "speak": "Pull back, and the tyre's own pressure slams that flap shut before a whisper escapes."
  },
  {
   "highlight": {
    "target": [
     "piston"
    ],
    "effect": "glow"
   },
   "speak": "On the way up the rubber cup peels off the wall, letting fresh air slip past it to refill the barrel — the seal works one way, like the valve."
  },
  {
   "point": {
    "at": {
     "ref": "body"
    },
    "gesture": "underline"
   },
   "speak": "The barrel gets hot as you work, and that is not friction: compressing a gas quickly heats it."
  },
  {
   "draw": [
    "punchline",
    "mark"
   ],
   "speak": "The pump never holds the pressure — the valve does. The piston just keeps handing it a little more air.",
   "delivery": "grave"
  }
 ]
}