  {
   "pause": 0.3
  },
  {
   "draw": [
    "sammensatt",
    "l_samm"
   ],
   "speak": "Men lar du rentene stå på kontoen, gir de selv rente, og kurven bøyer oppover."
  },
  {
   "draw": [
    "f_samm"
   ],
   "speak": "Formelen ved kurven: startbeløpet ganget med 1,07 én gang for hvert år som går."
  },
  {
   "pause": 0.3
  },
  {
