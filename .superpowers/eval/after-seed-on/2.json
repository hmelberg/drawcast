 "commands": [
  {
   "draw": [
    "tittel"
   ],
   "speak": "Når sømmen rynker seg eller det blir trådklumper under stoffet, er det nesten alltid én bestemt del som har skylda – så la oss se hva delene faktisk gjør."
  },
  {
   "draw": [
    "base",
    "column",
    "toparm",
    "head"
   ],
   "parallel": true
  },
  {
   "draw": [
    "spool",
    "topthread",
    "l_spool"
   ],
   "speak": "Fra trådsnellen øverst går overtråden hele veien ned til nåla."
  },
  {
   "draw": [
    "tension",
    "l_tension"
   ],
   "speak": "Underveis klemmes den mellom to spenningsskiver som holder den passe stram."
  },
  {
   "flow": {
    "along": [
     "topthread"
    ]
   },
   "speak": "For stramt, og stoffet rynker seg; for løst, og du får sløyfer på undersiden."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "needle",
    "l_needle"
   ],
   "speak": "Nåla har øyet ute i spissen, ikke bakerst – den frakter tråden ned gjennom stoffet."
  },
  {
   "draw": [
    "foot",
    "l_foot"
   ],
   "speak": "Trykkfoten presser stoffet mot platen, så det ikke følger med opp igjen når nåla løftes."
  },
  {
   "draw": [
    "feeddog",
    "l_feed"
   ],
   "speak": "Og mens nåla er oppe, skyver transportørens små tenner stoffet nøyaktig ett sting videre."
  },
  {
   "pause": 0.3
  },
  {
   "draw": [
    "bobbin",
    "l_bobbin"
   ],
   "speak": "Under platen ligger spolen med en helt egen tråd: undertråden."
  },
  {
   "camera": {
    "center": {
     "ref": "needle"
    },
    "zoom": 2.2
   },
   "speak": "Her skjer selve syingen – nåla dykker ned, og på vei opp danner overtråden en liten sløyfe under stoffet."
  },
  {
   "highlight": {
    "target": [
     "bobbin"
    ],
    "effect": "glow"
   },
   "speak": "En griper fanger sløyfa og drar den rundt undertråden."
  },
  {
   "draw": [
    "laas"
   ],
   "speak": "Knuten strammes inne i stoffet: et låssting, holdt av én tråd fra hver side – derfor kan ingen symaskin sy med bare én tråd.",
   "delivery": "grave"
  },
  {
   "camera": {
    "reset": true
   }
  },
  {
   "draw": [
    "howe"
   ],
   "speak": "Nettopp øyet i nålespissen og sting låst av en tråd under var kjernen i Elias Howes patent fra 1846."
  },
  {
   "erase": [
    "howe"
   ],
   "speak": "Alle bevegelsene drives av én eneste aksel gjennom maskinen."
  },
  {
   "draw": [
    "handwheel",
    "l_wheel"
   ],
   "speak": "Håndhjulet er grepet ditt på den akselen, så du kan kjøre et sting sakte for hånd."
  },
  {
   "speak": "Nå ser du hva som lager stinget: nåla leverer tråden ned, transportøren flytter stoffet, og spolen under låser knuten – og sømfeil er som regel spenningsskivene."
  }
 ]
