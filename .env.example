# drawcast — passord-vending (/.netlify/functions/keys)
# Local secrets for `netlify dev` ONLY — never deployed. For the live site,
# set the same names in the Netlify UI (Site configuration → Environment
# variables) or with: netlify env:set NAME 'verdi'

DRAWCAST_PASSWORD=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- PUBLIC, not secret (compiled into the browser bundle by Vite) ----------
# Also set these in Netlify env vars AND GitHub Actions secrets — the two
# deploys build separately, and a missing var silently hides the feature.
# Never put a paid API key behind a VITE_ prefix; it would ship in the bundle.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_KEY=
