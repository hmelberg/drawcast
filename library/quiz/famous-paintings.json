    "speak": "Four of the most famous paintings in the world. But who painted which?"
   },
   {
    "ask": {
     "question": "Match each painting to its painter: drag from one card to its partner.",
     "on": "art",
     "store": "m",
     "right": "All {m} right.",
     "wrong": "{m} right. Here are the true pairs.",
     "feedback": {
      "style": "warm",
      "perfect": "The museum guards would hire you.",
      "good": "A good eye for a brushstroke.",
      "poor": "Even gallery visitors mix these up.",
      "none": "Now you can stroll the galleries knowing four more."
     }
    }
   },
   {
    "highlight": {
     "target": [
      "art_2",
      "art_m_2"
     ]
    },
    "speak": "Van Gogh painted The Starry Night in 1889, from the view out of his room at an asylum in the south of France."
   },
   {
    "highlight": {
     "target": [
      "art_3",
      "art_m_3"
     ]
    },
    "speak": "Munch made The Scream in several versions, in paint and in pastel."
   },
   {
    "highlight": {
     "target": [
      "art_4",
      "art_m_4"
     ]
    },
    "speak": "And Vermeer's girl may be no portrait at all, but a study of a face in a fancy costume."
   },
   {
    "highlight": {
     "target": [
      "art_1",
      "art_m_1"
     ]
    },
    "speak": "But the most famous of them all was not always so famous."
   },
   {
    "erase": [
     "art"
    ]
   },
   {
    "draw": [
     "s1911",
     "empty"
    ],
    "speak": "In August 1911, a former Louvre worker, Vincenzo Peruggia, walked out with the Mona Lisa under his smock."
   },
   {
    "highlight": {
     "target": [
      "s1911"
     ]
    },
    "speak": "Newspapers around the world printed her face, and crowds queued to stare at the empty wall."
   },
   {
    "draw": [
     "s1913"
    ],
    "speak": "Two years later Peruggia tried to sell her in Florence, and was caught."
   },
   {
    "draw": [
     "mona"
    ]
   },
   {
    "speak": "She came home to Paris more famous than ever. The theft made her the world's best-known painting.",
    "draw": [
     "famous"
    ]
   }
