  "commands": [
   {
    "card": {
     "title": "What finishes Pythagoras' theorem?"
    }
   },
   {
    "draw": [
     "tri",
     "rt",
     "la",
     "lb",
     "lc"
    ],
    "speak": "A right-angled triangle, with sides a, b and c: three, four and five. How are the three sides linked?"
   },
   {
    "draw": [
     "sq_a",
     "sq_b",
     "sq_c"
    ],
    "speak": "Build a square on each side, and the answer is hiding in their areas."
   },
   {
    "draw": [
     "law"
    ]
   },
   {
    "ask": {
     "question": "Which tile finishes the theorem, so that it holds for every right triangle?",
     "on": "law",
     "others": [
      "c",
      "2c",
      "(a+b)^2"
     ],
     "store": "t",
     "right": "c squared: the two small squares together fill the big one.",
     "wrong": "Look at what the squares measure: areas."
    }
   },
   {
    "draw": [
     "grid_a",
     "n9"
    ],
    "speak": "Check it here. The square on the short side holds nine little squares,"
   },
   {
    "draw": [
     "grid_b",
     "n16"
    ],
    "speak": "the one on the side of four holds sixteen,"
   },
   {
    "draw": [
     "grid_c",
     "n25",
     "check"
    ],
    "speak": "and nine plus sixteen is twenty-five: exactly the big square."
   },
   {
    "draw": [
     "tablet"
    ],
    "speak": "It carries the name of Pythagoras, a Greek of about 500 BC. But a Babylonian clay tablet, Plimpton 322, lists such triples more than a thousand years earlier."
   },
   {
    "draw": [
     "rope"
    ],
    "speak": "And builders still use the trick: measure three along one wall and four along the other, and if the gap is five, the corner is square."
   },
   {
    "highlight": {
     "target": [
      "sq_c"
     ]
    },
    "speak": "So the big square is the sum of the two small ones, on every right triangle there is."
   }
  ]
 }
