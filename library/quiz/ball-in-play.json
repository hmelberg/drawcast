     "seg_play",
     "play_l"
    ],
    "speak": "With added time, a match now runs about ninety-eight minutes, and the ball is in play for about fifty-seven of them."
   },
   {
    "draw": [
     "seg_stop",
     "stop_l"
    ],
    "speak": "So for about forty minutes, the ball is standing still."
   },
   {
    "draw": [
     "c1",
     "c2",
     "c3"
    ],
    "speak": "It goes on throw-ins, free kicks and goal kicks, on substitutions, injuries and goal celebrations."
   },
   {
    "highlight": {
     "target": [
      "seg_stop"
     ]
    },
    "speak": "And on the slow walk to take them, when a team is winning and the clock is its friend."
   },
   {
    "draw": [
     "rule"
    ],
    "speak": "So in 2023 the Premier League told referees to add on the time lost to goals, substitutions and injuries."
   },
   {
    "highlight": {
     "target": [
      "seg_play"
     ]
    },
    "speak": "Added time grew, and the ball was in play for about three and a half minutes more per match."
   },
   {
    "point": {
     "at": {
      "ref": "stop_l"
     },
     "gesture": "underline"
    },
    "speak": "Even so, about forty minutes of every match are football with the ball at rest."
   }
