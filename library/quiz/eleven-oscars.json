  "commands": [
   {
    "card": {
     "title": "Which films won 11 Oscars?"
    }
   },
   {
    "draw": [
     "films"
    ],
    "speak": "The record for Oscars won by a single film is eleven, and only a handful of films have reached it."
   },
   {
    "ask": {
     "question": "Which of these films won eleven Oscars? Tap every one.",
     "on": "films",
     "store": "f",
     "right": "All {f.total} right.",
     "wrong": "{f} of {f.total} on the first try.",
     "feedback": {
      "style": "warm",
      "perfect": "You could host the ceremony.",
      "good": "A seasoned film buff.",
      "poor": "The epics blur together for most of us.",
      "none": "Hollywood fooled you this time."
     }
    }
   },
   {
    "draw": [
     "l_ben"
    ],
    "speak": "Three films share the record. Ben-Hur came first, in 1959, chariot race and all."
   },
   {
    "draw": [
     "l_tit"
    ],
    "speak": "Titanic matched it in 1997, from fourteen nominations."
   },
   {
    "draw": [
     "l_wss"
    ],
    "speak": "West Side Story came painfully close, with ten."
   },
   {
    "draw": [
     "l_rotk"
    ],
    "speak": "But the third, The Lord of the Rings: The Return of the King, did something the others did not."
   },
   {
    "draw": [
     "trophy"
    ],
    "speak": "It won every single award it was nominated for: eleven out of eleven."
   },
   {
    "point": {
     "at": {
      "ref": "l_rotk"
     },
     "gesture": "underline"
    },
    "speak": "And it was the first fantasy film ever to win Best Picture."
   }
  ],
