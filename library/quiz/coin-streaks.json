  "commands": [
   {
    "card": {
     "title": "Five heads in a row: what next?"
    }
   },
   {
    "draw": [
     "h1",
     "h2",
     "h3",
     "h4",
     "h5"
    ],
    "speak": "You toss a fair coin five times, and it lands heads every time. What comes next?",
    "voice": "a"
   },
   {
    "draw": [
     "next"
    ],
    "speak": "Tails, obviously. It's overdue!",
    "voice": "b"
   },
   {
    "quiz": {
     "question": "After five heads in a row, what is the chance the next toss is tails?",
     "choices": [
      "More than half",
      "Exactly half",
      "Less than half"
     ],
     "correct": 2,
     "right": "Exactly half. The coin has no memory: every toss starts from scratch.",
     "wrong": "Ask what the coin remembers.",
     "reveal": "50 : 50"
    }
   },
   {
    "speak": "But five heads in a row is rare. Doesn't that count for something?",
    "voice": "b",
    "highlight": {
     "target": [
      "h1",
      "h2",
      "h3",
      "h4",
      "h5"
     ]
    }
   },
   {
    "draw": [
     "odds"
    ],
    "speak": "It is rare: one chance in thirty-two.",
    "voice": "a"
   },
   {
    "highlight": {
     "target": [
      "next"
     ]
    },
    "speak": "But those five are already done. Only the next toss is still open, and it is a plain coin toss.",
    "voice": "a"
   },
   {
    "erase": [
     "heads",
     "odds"
    ]
   },
   {
    "draw": [
     "wheel",
     "where"
    ],
    "speak": "Tell that to a casino.",
    "voice": "b"
   },
   {
    "draw": [
     "big",
     "big_l",
     "blacks"
    ],
    "cue": 0.3,
    "speak": "Funny you should say that. In Monte Carlo, in August 1913, a roulette ball landed on black twenty-six times in a row.",
    "voice": "a"
   },
   {
    "draw": [
     "bets",
     "bags"
    ],
    "speak": "Gamblers piled their money on red, sure it was due. They lost millions.",
    "voice": "a"
   },
   {
    "draw": [
     "fall"
    ],
    "speak": "So the gambler's fallacy has a home address.",
    "voice": "b"
   },
   {
    "highlight": {
     "target": [
      "fall"
     ]
    },
    "speak": "It does. It's often called the Monte Carlo fallacy, and the wheel never knew it was on a streak.",
    "voice": "a"
   }
  ],
  "affirm": "playful"
 }
