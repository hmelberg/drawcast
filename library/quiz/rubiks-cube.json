  "commands": [
   {
    "card": {
     "title": "How many ways to mix a Rubik's cube?"
    }
   },
   {
    "draw": [
     "cube"
    ],
    "parallel": true,
    "speak": "Twist a Rubik's cube a few times, and it's a mess. But how many different messes are there?"
   },
   {
    "draw": [
     "pos"
    ],
    "speak": "Each step along this line is ten times the one before."
   },
   {
    "ask": {
     "question": "How many different positions can a Rubik's cube be in? Click on the line.",
     "on": "pos",
     "store": "g",
     "default": "1000000000",
     "tolerance": 0.08,
     "right": "Close. It is about forty-three quintillion.",
     "wrong": "Most people guess far too low."
    }
   },
   {
    "hide": [
     "pos_answer_num"
    ]
   },
   {
    "draw": [
     "big"
    ],
    "speak": "Forty-three quintillion: a forty-three followed by eighteen zeros."
   },
   {
    "draw": [
     "age"
    ],
    "speak": "Show one new position every second, and you'd need about a hundred times the age of the universe to see them all."
   },
   {
    "draw": [
     "god"
    ],
    "speak": "And yet every single one can be solved in twenty moves or fewer."
   },
   {
    "speak": "That limit is called God's number. A team proved it in 2010, using about thirty-five years of computer time donated by Google.",
    "draw": [
     "god_l",
     "cpu"
    ]
   },
   {
    "speak": "They did not solve the positions one by one: they grouped them into huge families, and used the cube's symmetry to deal with whole families at once.",
    "highlight": {
     "target": [
      "god"
     ]
    }
   },
   {
    "speak": "So no mess is ever more than twenty twists from home, even if finding those twenty is the hard part.",
    "highlight": {
     "target": [
      "god",
      "god_l"
     ],
     "effect": "circle"
    }
   }
  ],
  "affirm": "playful"
 }
}