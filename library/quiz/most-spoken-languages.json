   {
    "draw": [
     "langs"
    ],
    "speak": "Five of the world's great languages. Which has the most native speakers, the people who learned it first, as children?"
   },
   {
    "ask": {
     "question": "Put these languages in order of native speakers, from most to fewest. Drag the cards, then press Answer.",
     "on": "langs",
     "store": "r",
     "right": "You got {r}.",
     "wrong": "You got {r}."
    }
   },
   {
    "draw": [
     "h_nat",
     "n_zh"
    ],
    "speak": "Mandarin wins by a mile: nearly a billion people grew up speaking it."
   },
   {
    "draw": [
     "n_es"
    ],
    "speak": "Spanish comes second, thanks to Latin America, with almost half a billion."
   },
   {
    "draw": [
     "n_en",
     "n_hi"
    ],
    "speak": "Then English and Hindi, close together at around three hundred and fifty million or so each."
   },
   {
    "draw": [
     "n_fr"
    ],
    "speak": "French, for all its fame, has only about seventy-five million native speakers."
   },
   {
    "draw": [
     "h_tot",
     "t_zh",
     "t_es",
     "t_en",
     "t_hi",
     "t_fr"
    ],
    "speak": "But count everyone who speaks a language, natively or not, and the order changes."
   },
   {
    "draw": [
     "first"
    ],
    "speak": "English jumps to first, with about one and a half billion speakers. Most of them learned it as a second language."
   },
   {
    "highlight": {
     "target": [
      "t_en"
     ],
     "effect": "circle"
    },
    "speak": "So the world's most spoken language is mostly spoken with an accent."
