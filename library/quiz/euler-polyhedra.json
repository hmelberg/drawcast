    "speak": "Take a cube. Count its corners, take away its edges, and add its faces. What do you get?"
   },
   {
    "ask": {
     "question": "For a cube: corners minus edges plus faces. Type the number you get.",
     "answer": "2",
     "right": "Two: eight corners, minus twelve edges, plus six faces.",
     "wrong": "Count the hidden corner at the back too."
    }
   },
   {
    "draw": [
