    "type": "text",
    "text": "feels nothing",
    "x": 330,
    "y": 590,
    "font_size": 42,
    "style": {
     "color": "#2f6b8f"
    }
   }
  ],
  "commands": [
   {
    "card": {
     "title": "How hot are the hottest peppers?"
    }
   },
   {
    "draw": [
     "shu",
     "shu_l",
     "chili",
     "bell",
     "bell_l"
    ],
    "parallel": true,
    "speak": "Chilli heat is measured in Scoville units, and a sweet bell pepper scores zero. Each step on this line is ten times hotter than the last."
   },
   {
    "draw": [
     "heat"
    ]
   },
   {
    "ask": {
     "question": "How hot is each pepper? Drag each card to its place on the Scoville scale.",
     "on": "heat",
     "store": "p",
     "tolerance": 0.08,
     "right": "All {p.total} close.",
     "wrong": "{p} of {p.total} close."
    }
   },
   {
    "highlight": {
     "target": [
      "heat_1"
     ]
    },
    "speak": "A jalapeño is a gentle few thousand units."
   },
   {
    "highlight": {
     "target": [
      "heat_2"
     ]
    },
    "speak": "A habanero sits in the hundreds of thousands."
   },
   {
    "highlight": {
     "target": [
      "heat_3"
     ]
    },
    "speak": "The Carolina Reaper averages about one point six million: as hot as some police pepper spray."
   },
   {
    "highlight": {
     "target": [
      "heat_4"
     ]
    },
    "speak": "And since 2023 the record belongs to Pepper X, from the same grower, at about two point seven million."
   },
   {
    "erase": [
     "bell",
     "bell_l"
    ]
   },
   {
    "draw": [
     "trpv1"
    ],
    "speak": "Yet none of it is real heat. The burn comes from capsaicin, which switches on a heat sensor in your nerves called TRPV1."
   },
   {
    "draw": [
     "nerve",
     "brain"
    ],
    "speak": "Your brain is told you are on fire. David Julius used chilli to find that sensor, and shared the Nobel Prize for it in 2021."
   },
   {
    "erase": [
     "brain",
     "trpv1"
    ]
   },
   {
    "draw": [
     "bird",
     "nofeel"
    ],
    "speak": "Birds have a version of the sensor that capsaicin cannot switch on. So they eat chillies happily, and spread the seeds."
   },
   {
    "point": {
     "at": {
      "ref": "chili"
     },
     "gesture": "underline"
    },
    "speak": "The burn may be the plant's way of choosing who gets to eat it."
   }
  ],
  "text": {
   "font_size": 34
  },
