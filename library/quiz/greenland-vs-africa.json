{
 "request": "Greenland looks as big as Africa on a map. How big is it really? Let me guess with a bar. #interactive #short",
 "subtitle": "Guess Greenland's size next to Africa with a bar, then see why the Mercator map makes the two look the same size.",
 "spec": {
  "title": "How big is Greenland next to Africa?",
  "template": "bar_chart",
  "params": {
   "labels": [
    "Africa",
    "Greenland",
    "DR Congo",
    "USA+China+India"
   ],
   "values": [
    30.37,
    2.17,
    2.34,
    22.72
   ],
   "icons": [
    {
     "of": "globe showing europe-africa",
     "set": "twemoji"
    },
    {
     "of": "flag greenland",
     "set": "twemoji"
    },
    {
     "of": "flag congo kinshasa",
     "set": "twemoji"
    },
    {
     "of": "flag united states",
     "set": "twemoji"
    }
   ],
   "value_labels": true,
   "ylim": [
    0,
    34
   ],
   "y_label": "Million km²",
   "bar_colors": "each"
  },
  "sources": [
   {
    "id": "cia",
    "title": "The World Factbook: Greenland; Democratic Republic of the Congo; United States; China; India",
    "authors": "CIA",
    "year": 2025,
    "finding": "Greenland 2,166,086 km²; DR Congo 2,344,858 km²; USA 9.83, China 9.6, India 3.29 million km² (22.7 together)"
   },
   {
    "id": "afr",
    "title": "Africa",
    "authors": "Encyclopaedia Britannica",
    "year": 2025,
    "finding": "Africa covers about 30.4 million km²"
   }
  ],
  "elements": [
   {
    "id": "map",
    "type": "icon",
    "of": "world map",
    "set": "twemoji",
    "icon_look": "picture",
    "size": 230,
    "x": 780,
    "y": 520
   },
   {
    "id": "merc",
    "type": "text",
    "text": "Mercator, 1569",
    "x": 780,
    "y": 385,
    "font_size": 40,
    "style": {
     "color": "#2f6b8f"
    }
   },
   {
    "id": "fits",
    "type": "text",
    "text": "room to spare",
    "x": 620,
    "y": 620,
    "font_size": 40,
    "style": {
     "color": "#2f6b8f"
    }
   }
  ],
  "commands": [
   {
    "card": {
     "title": "How big is Greenland next to Africa?"
    }
   },
   {
    "draw": [
     "axes",
     "bar_1"
    ],
    "speak": "On most wall maps, Greenland looks about as big as Africa."
   },
   {
    "ask": {
     "question": "Africa is drawn. How big is Greenland? Drag its bar to your guess.",
     "on": "bar_2",
     "store": "g",
     "default": "20",
     "right": "Close: you said {g} million square kilometres, and it is {g.true}.",
     "wrong": "You said {g} million square kilometres; it is only {g.true}.",
     "reveal": {
      "text": "14 × smaller",
      "at": {
       "x": 480,
       "y": 430
      }
     }
    }
   },
   {
    "speak": "Africa is about fourteen times bigger: thirty million square kilometres against two.",
    "highlight": {
     "target": [
      "bar_1",
      "bar_2"
     ]
    }
   },
   {
    "draw": [
     "map",
     "merc"
    ],
    "speak": "The culprit is the map itself, drawn by Gerardus Mercator in 1569 for sailors."
   },
   {
    "point": {
     "at": {
      "ref": "bar_2"
     },
     "gesture": "underline"
    },
    "speak": "It keeps compass directions true, so a straight line on it is a steady course across the sea."
   },
   {
    "highlight": {
     "target": [
      "bar_2"
     ],
     "effect": "circle"
    },
    "speak": "But to do that it stretches the land more and more toward the poles, and Greenland sits far in the north."
   },
   {
    "draw": [
     "bar_3"
    ],
    "speak": "In fact Greenland is smaller than a single African country, the Democratic Republic of the Congo."
   },
   {
    "erase": [
     "map",
     "merc"
    ]
   },
   {
    "draw": [
     "bar_4",
     "fits"
    ],
    "speak": "And Africa could swallow the United States, China and India together, with room to spare."
   },
   {
    "highlight": {
     "target": [
      "bar_1"
     ]
    },
    "speak": "So next time you see a world map, look twice at the top and bottom."
   }
  ],
  "text": {
   "font_size": 34
  },
