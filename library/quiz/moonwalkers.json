     "a9",
     "a10",
     "a11",
     "a12"
    ],
    "speak": "Six Apollo crews landed, each putting two men on the surface while a third waited in orbit."
   },
   {
    "draw": [
     "x13",
     "x13b"
    ],
    "speak": "Every mission from Apollo 11 to 17 landed, but one."
   },
   {
    "highlight": {
     "target": [
      "m13"
     ]
    },
    "speak": "Apollo 13 never got there. An oxygen tank exploded on the way, and the crew only just made it home."
   },
   {
    "draw": [
     "first"
    ],
    "speak": "Neil Armstrong stepped out first, in July 1969, and Buzz Aldrin followed him about twenty minutes later.",
    "cue": 0.45
   },
   {
    "draw": [
     "last"
    ],
    "speak": "The last was Gene Cernan, in December 1972."
   },
   {
    "draw": [
     "tdc"
    ],
    "speak": "Before he climbed back in, he traced his daughter's initials in the lunar dust."
   },
   {
    "highlight": {
     "target": [
      "twelve"
     ]
    },
    "speak": "No one has walked there since, in more than fifty years. So the club is still just twelve."
   }
