  "commands": [
   {
    "card": {
     "title": "How many Earths fit to the Moon?"
    }
   },
   {
    "draw": [
     "earth",
     "earth_l",
     "moon",
     "moon_l"
    ],
    "speak": "Here is the Earth, and here is the Moon, drawn to scale. How many Earths could you line up in the gap between them?"
   },
   {
    "draw": [
     "gap_line",
     "dist",
     "n"
    ]
   },
   {
    "ask": {
     "question": "How many Earths, side by side, would fill the gap to the Moon? Click on the line.",
     "on": "n",
     "store": "g",
     "default": "10",
     "tolerance": 0.06,
     "right": "Close: you said {g}, and it is about {g.true}.",
     "wrong": "You said {g}; it is about {g.true}."
    }
   },
   {
    "hide": [
     "n"
    ]
   },
   {
    "draw": [
     "earths",
     "t30"
    ],
    "speak": "About thirty. The Moon is much farther away than most pictures suggest."
   },
   {
    "erase": [
     "t30",
     "dist",
     "gap_line",
     "earths"
    ]
   },
   {
    "draw": [
     "small",
     "small_l",
     "small_a"
    ],
    "speak": "But here's the real surprise. Start lining up the other planets: Mercury, Venus, Mars."
   },
   {
    "erase": [
     "small_l",
     "small_a"
    ]
   },
   {
    "draw": [
     "giants"
    ],
    "speak": "Then the giants: Jupiter, Saturn, Uranus and Neptune."
   },
   {
    "draw": [
     "spare"
    ],
    "speak": "All seven fit in the gap. Just."
   },
   {
    "highlight": {
     "target": [
      "jupiter",
      "saturn"
     ]
    },
    "speak": "It's tight, though. Jupiter and Saturn spin so fast they bulge at the middle, so they have to stand pole to pole, like here."
   },
   {
    "speak": "And when the Moon is at its farthest, they fit whichever way you turn them.",
    "move": {
     "target": [
      "moon"
     ],
     "by": [
      44,
      0
     ],
     "duration": 1.5
    }
   },
   {
    "highlight": {
     "target": [
      "jupiter",
      "saturn"
     ]
    },
    "speak": "So more than half of that gap is just Jupiter and Saturn."
   }
  ]
 }
