  "commands": [
   {
    "card": {
     "title": "How much richer is the richest country?"
    }
   },
   {
    "draw": [
     "fl_sg",
     "n_sg"
    ],
    "voice": "a",
    "speak": "Take the richest country in the world, by income per person, and the poorest. How many times richer is the richest?"
   },
   {
    "draw": [
     "fl_bi",
     "n_bi"
    ],
    "voice": "b",
    "speak": "Ten times? Twenty, tops. Things are much cheaper in poor countries, after all."
   },
   {
    "ask": {
     "question": "Set the counter to your guess.",
     "estimate": {
      "min": 1,
      "max": 1000,
      "value": 130,
      "unit": "times",
      "log": true
     },
     "store": "r",
     "default": "20",
     "right": "Close: you said {r} times, and it is about {r.true}.",
     "wrong": "You said {r}; it is about {r.true} times."
    }
   },
   {
    "erase": [
     "estimate_1"
    ]
   },
   {
    "draw": [
     "cb",
     "key"
    ],
    "voice": "a",
    "speak": "Here is Burundi, the poorest: about a thousand dollars per person a year. One coin."
   },
   {
    "draw": [
     "rich",
     "v_sg"
    ],
    "voice": "a",
    "speak": "And Singapore: about a hundred and forty thousand. A hundred and thirty coins."
   },
   {
    "draw": [
     "day"
    ],
    "voice": "b",
    "speak": "But I said things are cheaper there!"
   },
   {
    "highlight": {
     "target": [
      "key"
     ]
    },
    "voice": "a",
    "speak": "They are, and it's already counted: these dollars are adjusted for prices. Burundi still lives on under three dollars a day."
   },
   {
    "erase": [
     "v_sg"
    ]
   },
   {
    "draw": [
     "x130"
    ],
    "voice": "b",
    "speak": "Was it always this unequal?"
   },
   {
    "erase": [
     "key",
     "day"
    ]
   },
   {
    "draw": [
     "fl_uk",
     "n_uk",
     "fl_np",
     "n_np",
     "ukc",
     "cn",
     "y1820"
    ],
    "voice": "a",
    "speak": "No. In 1820, among the countries with estimates, the richest, Britain, was only about five times richer than the poorest, Nepal."
   },
   {
    "voice": "a",
    "speak": "Back then nearly everyone was poor. Growth took off in a few places, and by these long-run estimates the poorest countries today are no richer than Nepal was then.",
    "highlight": {
     "target": [
      "cn",
      "cb"
     ]
    }
   },
   {
    "highlight": {
     "target": [
      "rich",
      "ukc"
     ]
    },
    "voice": "b",
    "speak": "Five coins to a hundred and thirty. Next time someone tells me the world was always this way, I'm bringing my coins."
   }
  ]
