   {
    "card": {
     "title": "How old is the typical person?"
    }
   },
   {
    "draw": [
     "age"
    ],
    "speak": "How old is the typical person in a country? Line everyone up by age and take the one in the middle: that is the median age."
   },
   {
    "draw": [
     "lands"
    ],
    "speak": "Here are five countries, from Africa, South America, North America, Europe and Asia."
   },
   {
    "ask": {
     "question": "Drag each country to its median age on the line.",
     "on": "lands",
     "store": "w",
     "tolerance": 0.08,
     "right": "All {w.total} close.",
     "wrong": "{w.within} of {w.total} close."
    }
   },
   {
    "draw": [
     "pt_ner",
     "n_ner",
     "pt_bra",
     "n_bra",
     "pt_usa",
     "n_usa",
     "pt_ita",
     "n_ita",
     "pt_jpn",
     "n_jpn"
    ],
    "parallel": true,
    "speak": "Here are the true ages: from about fifteen in Niger to forty-nine in Japan."
   },
   {
    "highlight": {
     "target": [
      "n_ner"
     ],
     "effect": "circle"
    },
    "speak": "Niger is one of the youngest countries on Earth: half its people are children."
   },
   {
    "draw": [
     "gap_arrow",
     "gap_l"
    ],
    "speak": "So Japan's middle person is thirty-four years older than Niger's."
   },
   {
    "erase": [
     "gap_arrow",
     "gap_l"
    ]
   },
   {
    "draw": [
     "world_pt",
     "world_l"
    ],
    "speak": "And the whole world sits between them, at about thirty."
   },
   {
    "erase": [
     "world_l"
    ]
   },
   {
    "draw": [
     "jp50_arrow",
     "jp50_pt",
     "jp50_l"
    ],
    "speak": "But Japan was not always old. In 1950, its median age was twenty-one."
   },
   {
    "highlight": {
     "target": [
      "lands_2"
     ]
    },
    "speak": "That is younger than Brazil is today."
   },
   {
    "highlight": {
     "target": [
      "jp50_arrow"
     ]
    },
    "speak": "Fewer babies and much longer lives aged Japan by nearly thirty years in seven decades."
   },
   {
    "erase": [
     "jp50_arrow",
     "jp50_l",
     "jp50_pt"
    ]
   },
   {
    "draw": [
     "ner_arrow",
     "ner_l"
    ],
    "speak": "Niger is on the same road, only later: the UN expects its median age to pass thirty around 2082."
   },
   {
    "draw": [
     "same"
    ],
    "speak": "So one of the youngest countries today may one day be as old as the whole world is now."
   }
  ],
