  "commands": [
   {
    "card": {
     "title": "Which is the world's happiest country?"
    }
   },
   {
    "draw": [
     "suspects"
    ],
    "voice": "a",
    "speak": "Which country tops the World Happiness Report? Let's play this one together. Here are four suspects."
   },
   {
    "draw": [
     "c1",
     "c2"
    ],
    "voice": "a",
    "speak": "Clue one: it's rich, but about a quarter poorer per person than the United States. Clue two: its winters are long and dark."
   },
   {
    "highlight": {
     "target": [
      "o_dk"
     ]
    },
    "voice": "b",
    "speak": "Denmark, then. Danes are always called the happiest people on Earth."
   },
   {
    "draw": [
     "c3"
    ],
    "voice": "a",
    "speak": "Clue three: it has a long border with Russia."
   },
   {
    "ask": {
     "question": "Tap the country.",
     "choose": [
      "o_us",
      "o_dk",
      "o_cr",
      "o_fi"
     ],
     "answer": "o_fi",
     "right": "Finland: about seven point eight out of ten, top for nine years running.",
     "wrong": "Denmark used to win, but not lately."
    }
   },
   {
    "erase": [
     "c1",
     "c2",
     "c3",
     "suspects"
    ]
   },
   {
    "draw": [
     "ladder",
     "l0",
     "l10"
    ],
    "voice": "b",
    "speak": "Finland? Finns are famous for not smiling at strangers."
   },
   {
    "draw": [
     "g_fi"
    ],
    "voice": "a",
    "speak": "Which is the point: nobody is asked if they feel cheerful. They picture a ladder, from the worst possible life for them to the best, and say which step they stand on."
   },
   {
    "draw": [
     "g_af"
    ],
    "voice": "a",
    "speak": "At the bottom is Afghanistan, at about one point four."
   },
   {
    "highlight": {
     "target": [
      "p_fi"
     ]
    },
    "voice": "b",
    "speak": "So money decides it. The United States must be right up there."
   },
   {
    "draw": [
     "g_us"
    ],
    "voice": "a",
    "speak": "Twenty-fourth, at about six point eight. Richer countries do tend to rate their lives higher, but not always."
   },
   {
    "voice": "b",
    "speak": "Then who beats America with less money?",
    "highlight": {
     "target": [
      "p_us"
     ]
    }
   },
   {
    "draw": [
     "g_cr"
    ],
    "voice": "a",
    "speak": "Costa Rica: about a third of America's income per person, and fourth on the ladder. Money buys a few rungs, not the whole climb."
   },
   {
    "highlight": {
     "target": [
      "g_cr"
     ]
    }
   }
  ]
 },
