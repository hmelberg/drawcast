  "commands": [
   {
    "card": {
     "title": "How many of us does fertilizer feed?"
    }
   },
   {
    "draw": [
     "crowd0"
    ],
    "voice": "a",
    "speak": "Imagine these hundred people stand for everyone alive. How many of them owe their food to fertilizer made in a factory?"
   },
   {
    "hide": [
     "crowd0"
    ]
   },
   {
    "ask": {
     "question": "Sweep across the people it feeds.",
     "on": "crowd_fed",
     "store": "g",
     "default": "10",
     "right": "Close: you said {g}, and it is about {g.true}.",
     "wrong": "You said {g}. It is about {g.true} in a hundred."
    }
   },
   {
    "draw": [
     "n48"
    ],
    "voice": "a",
    "speak": "About forty-eight in a hundred: across the world, roughly four billion people."
   },
   {
    "highlight": {
     "target": [
      "crowd_fed"
     ]
    },
    "voice": "b",
    "speak": "Half of us? Fed by a sack of fertilizer?"
   },
   {
    "erase": [
     "crowd",
     "n48"
    ]
   },
   {
    "draw": [
     "air",
     "n78"
    ],
    "voice": "a",
    "speak": "By the nitrogen in it. Crops need nitrogen, and the air is mostly nitrogen, but in a form no plant can use."
   },
   {
    "draw": [
     "a1",
     "hb",
     "hb_l"
    ],
    "voice": "a",
    "speak": "In 1909 the German chemist Fritz Haber found how to pull it out of the air as ammonia, and by 1913 Carl Bosch had it running in a factory."
   },
   {
    "draw": [
     "a2",
     "bread",
     "bread_l"
    ],
    "voice": "b",
    "speak": "So half of us eat bread made from thin air."
   },
   {
    "erase": [
     "air",
     "n78",
     "a1",
     "hb",
     "hb_l",
     "a2",
     "bread",
     "bread_l"
    ]
   },
   {
    "draw": [
     "nobel",
     "nobel_l"
    ],
    "voice": "a",
    "speak": "Pretty much. Haber won the Nobel Prize for it in 1918."
   },
   {
    "draw": [
     "gas",
     "gas_l"
    ],
    "voice": "b",
    "speak": "Wait, Haber? Isn't he the man behind the poison gas of the First World War?"
   },
   {
    "highlight": {
     "target": [
      "gas_l"
     ]
    },
    "voice": "a",
    "speak": "He is. He oversaw the first chlorine gas attack, at Ypres in 1915.",
    "delivery": "grave"
   },
   {
    "highlight": {
     "target": [
      "nobel_l",
      "gas_l"
     ]
    },
    "voice": "b",
    "speak": "The father of chemical warfare, and the reason billions of people are fed. Quite a legacy."
   }
  ]
 }
