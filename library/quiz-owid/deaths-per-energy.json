    ]
   },
   {
    "draw": [
     "axes",
     "bar_5",
     "bar_4"
    ],
    "voice": "a",
    "speak": "Deaths per terawatt-hour, about a year of power for a town of a hundred and fifty thousand. Coal, about twenty-five. Oil, about eighteen."
   },
   {
    "voice": "b",
    "speak": "Mine collapses? Oil rig fires?",
    "highlight": {
     "target": [
      "bar_5",
      "bar_4"
     ]
    }
   },
   {
    "draw": [
     "bar_3"
    ],
    "voice": "a",
    "speak": "Mostly not. Mostly smoke in people's lungs. Gas burns cleaner: about three."
   },
   {
    "draw": [
     "bar_1",
     "bar_2"
    ],
    "voice": "b",
    "speak": "Now nuclear. Brace yourself."
   },
