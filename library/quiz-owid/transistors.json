  "commands": [
   {
    "card": {
     "title": "One chip vs the planet: which is bigger?"
    }
   },
   {
    "draw": [
     "chip"
    ],
    "voice": "a",
    "speak": "How many tiny switches, called transistors, fit on one computer chip today?"
   },
   {
    "draw": [
     "t1971"
    ],
    "voice": "a",
    "speak": "The first microprocessor, Intel's 4004 in 1971, had about two thousand three hundred."
   },
   {
    "highlight": {
     "target": [
      "t1971"
     ]
    },
    "voice": "b",
    "speak": "So today, what, a few million? It's still one little chip."
   },
   {
    "draw": [
     "duel"
    ],
    "voice": "a",
    "speak": "Let's settle it with a duel: one chip from 2021 against two rivals."
   },
   {
    "ask": {
     "question": "Tap the bigger number in each pair.",
     "on": "duel",
     "store": "d",
     "right": "One chip beats every person on Earth, and the chickens still beat the chip.",
     "wrong": "{d} of {d.total}. The chip is bigger than you think, but not big enough for the chickens.",
     "stage": "own"
    }
   },
   {
    "erase": [
     "duel",
     "t1971"
    ]
   },
   {
    "draw": [
     "big"
    ],
    "voice": "b",
    "speak": "Wait. One chip has more switches than there are people on the planet?"
   },
   {
    "draw": [
     "per"
    ],
    "voice": "a",
    "speak": "Fifty-eight billion of them. That's about seven for every person alive, on one chip."
   },
   {
    "draw": [
     "times"
    ],
    "voice": "a",
    "speak": "From two thousand three hundred to fifty-eight billion: twenty-five million times more in fifty years."
   },
   {
    "highlight": {
     "target": [
      "per"
     ]
    },
    "voice": "b",
    "speak": "Seven each, and I never got mine. I'd like them back, please."
   }
