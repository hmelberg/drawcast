    }
   },
   {
    "highlight": {
     "target": [
      "bar_1"
     ]
    },
    "speak": "Recycled: about nine percent. Fewer than one piece in ten."
   },
   {
    "highlight": {
     "target": [
      "bar_4",
      "bar_2"
     ]
    },
    "speak": "Half goes into landfill, and a fifth is burned."
   },
   {
    "highlight": {
     "target": [
      "bar_3"
     ]
    },
    "speak": "And over a fifth is mismanaged: dumped, burned in open pits or left to blow away. That's the plastic that can reach rivers and the sea."
   },
   {
    "erase": [
     "axes",
