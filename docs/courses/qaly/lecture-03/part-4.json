    ],
    "speak": "Much less: it must be a good, agreed measure of health, not a perfect model of each person's choices."
   },
   {
    "draw": [
     "ex_box",
     "ex_line_1"
    ],
    "speak": "Our example reads cleanly this way: 1.5 QALYs gained for 30,000 more — 20,000 per QALY, set against the payer's threshold λ."
