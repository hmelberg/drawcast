    }
   },
   {
    "draw": [
     "usscale_answer"
    ],
    "speak": "About twelve and a half thousand dollars, for every man, woman and child."
   },
   {
    "draw": [
     "oecd_tick",
     "oecd_lab"
    ],
    "speak": "The typical rich country spends around five thousand, less than half as much."
   },
